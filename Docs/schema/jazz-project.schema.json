          "items": {
            "$ref": "#/$defs/mediaStream"
          }
        },
        "probedAt": {
          "type": "string",
          "format": "date-time"
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaChapter"
          }
