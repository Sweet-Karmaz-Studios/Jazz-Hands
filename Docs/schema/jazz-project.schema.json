    "quickTrim": {
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string"
        }
      },
      "required": [
        "mediaId"
      ]
    },
    "rational": {
      "type": "object",
      "description": "An exact ratio. Frame rates are written this way so that 30000/1001 stays exact.",
      "required": [
        "num",
        "den"
      ],
      "properties": {
        "num": {
          "type": "integer"
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sequence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          }
        },
        "markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marker"
          }
        },
        "settings": {
          "anyOf": [
            {
              "$ref": "#/$defs/projectSettings"
            },
            {
              "type": "null"
            }
          ]
        },
        "inOut": {
          "anyOf": [
            {
              "$ref": "#/$defs/timeRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "quickTrim": {
          "anyOf": [
            {
              "$ref": "#/$defs/quickTrim"
            },
            {
              "type": "null"
            }
          ]
        },
        "magnetic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "master": {
          "anyOf": [
            {
              "$ref": "#/$defs/masterBus"
            },
            {
              "type": "null"
