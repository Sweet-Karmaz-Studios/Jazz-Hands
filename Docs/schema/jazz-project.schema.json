        "feather": {
          "anyOf": [
            {
              "$ref": "#/$defs/animatedValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "opacity": {
          "anyOf": [
            {
              "$ref": "#/$defs/animatedValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "add",
            "subtract",
            "intersect"
          ]
        },
        "invert": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "expansion": {
          "anyOf": [
            {
              "$ref": "#/$defs/animatedValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "shape"
      ]
    },
    "masterBus": {
      "type": "object",
      "properties": {
        "volume": {
          "anyOf": [
            {
              "$ref": "#/$defs/animatedValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "limiter": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "ceiling": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "mediaChapter": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/flicks"
        },
        "end": {
          "$ref": "#/$defs/flicks"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "title"
      ]
    },
    "mediaInfo": {
      "type": "object",
      "properties": {
