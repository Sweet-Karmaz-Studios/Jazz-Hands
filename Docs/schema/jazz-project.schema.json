  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "settings": {
      "$ref": "#/$defs/projectSettings"
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mediaItem"
      }
    },
    "sequences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sequence"
      }
    },
    "activeSequenceId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "presets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/storedExportPreset"
      }
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "modified": {
      "type": "string",
      "format": "date-time"
    },
    "effectPresets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effectPreset"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "settings"
  ],
  "$defs": {
    "animatedValue": {
      "description": "Either a parameter value, or an object with a keyframes array.",
