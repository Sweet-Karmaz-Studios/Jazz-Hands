        "frameRate": {
          "anyOf": [
            {
              "$ref": "#/$defs/rational"
            },
            {
              "type": "null"
            }
          ]
        },
        "bitDepth": {
          "type": "integer"
        },
        "isInterlaced": {
          "type": "boolean"
        },
        "isVariableFrameRate": {
          "type": "boolean"
        },
        "isHdr": {
          "type": "boolean"
        },
        "hasAlpha": {
          "type": "boolean"
        },
        "sampleRate": {
          "type": "integer"
        },
        "channels": {
          "type": "integer"
        },
        "channelLayout": {
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/streamColor"
