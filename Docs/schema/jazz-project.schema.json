        "id": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "duration": {
          "$ref": "#/$defs/flicks"
        },
        "hash": {
          "type": "string"
        },
        "proxyPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
