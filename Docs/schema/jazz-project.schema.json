          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "paramValue": {
      "description": "The value of an animatable parameter. A number is a float, a boolean is a bool, a string is text, an array of two or four numbers is a vector, and everything else carries a type tag.",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 4
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "float",
                "float2",
                "float4",
                "color",
                "bool",
                "int",
                "enum",
                "path",
                "text"
              ]
            }
          }
        }
      ]
    },
    "projectSettings": {
      "type": "object",
      "properties": {
        "frameRate": {
          "$ref": "#/$defs/rational"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "sampleRate": {
          "type": "integer"
        },
        "channelCount": {
          "type": "integer"
