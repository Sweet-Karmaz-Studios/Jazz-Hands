        {
          "type": "object",
          "required": [
            "keyframes"
          ],
          "properties": {
            "keyframes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/keyframe"
              }
            }
          }
        },
        {
          "$ref": "#/$defs/paramValue"
        }
      ]
    },
    "clip": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/timeRange"
        },
        "sourceIn": {
          "$ref": "#/$defs/flicks"
        },
        "mediaId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "generatorId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequenceId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceStreamIndex": {
          "type": "integer"
        },
        "speed": {
          "anyOf": [
            {
              "$ref": "#/$defs/rational"
            },
            {
              "type": "null"
            }
          ]
        },
        "reverse": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/transform"
            },
            {
              "type": "null"
            }
          ]
        },
        "opacity": {
          "anyOf": [
            {
              "$ref": "#/$defs/animatedValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "blendMode": {
          "type": "string",
          "enum": [
            "normal",
            "add",
            "multiply",
            "screen",
            "overlay",
            "darken",
            "lighten",
            "difference",
            "softLight",
            "hardLight"
          ]
        },
        "volume": {
          "anyOf": [
            {
              "$ref": "#/$defs/animatedValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "pan": {
          "anyOf": [
            {
              "$ref": "#/$defs/animatedValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "fadeIn": {
          "anyOf": [
            {
              "$ref": "#/$defs/fade"
            },
            {
              "type": "null"
            }
          ]
        },
        "fadeOut": {
          "anyOf": [
            {
              "$ref": "#/$defs/fade"
            },
            {
              "type": "null"
            }
          ]
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marker"
          }
        },
        "linkGroupId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "groupId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "channelMap": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "auto",
                "left",
                "right",
                "mono"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "crop": {
          "anyOf": [
            {
              "$ref": "#/$defs/crop"
            },
            {
              "type": "null"
            }
          ]
        },
        "masks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mask"
          }
        },
        "hold": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "toneMap": {
          "anyOf": [
            {
              "$ref": "#/$defs/toneMapping"
            },
            {
              "type": "null"
            }
          ]
        },
        "cue": {
          "anyOf": [
            {
              "$ref": "#/$defs/cue"
            },
            {
              "type": "null"
            }
          ]
        },
        "remap": {
          "anyOf": [
            {
              "$ref": "#/$defs/animatedValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "retime": {
          "type": "string",
          "enum": [
            "nearest",
            "blend",
            "opticalFlow"
          ]
        },
        "motionBlur": {
          "anyOf": [
            {
              "$ref": "#/$defs/motionBlur"
            },
            {
              "type": "null"
            }
          ]
        },
        "matte": {
          "anyOf": [
            {
              "$ref": "#/$defs/trackMatte"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "range",
        "sourceIn"
      ]
    },
    "crop": {
      "type": "object",
      "properties": {
        "left": {
          "$ref": "#/$defs/animatedValue"
        },
        "top": {
          "$ref": "#/$defs/animatedValue"
        },
        "right": {
          "$ref": "#/$defs/animatedValue"
        },
        "bottom": {
          "$ref": "#/$defs/animatedValue"
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ]
    },
    "cue": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "align": {
          "type": "string",
          "enum": [
            "bottomLeft",
            "bottom",
            "bottomRight",
            "left",
            "middle",
            "right",
            "topLeft",
            "top",
            "topRight"
          ]
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
