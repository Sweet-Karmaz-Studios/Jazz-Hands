{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jazzhands.dev/schema/jazz-project.schema.json",
  "title": "Jazz Hands project (.jazz)",
  "description": "Generated from the JazzHands.Core model by tools/gen-schema. Do not edit by hand: change the records and regenerate. Members not described here are preserved on save and reported as warnings rather than rejected.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "settings": {
      "$ref": "#/$defs/projectSettings"
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mediaItem"
      }
    },
    "sequences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sequence"
      }
    },
    "activeSequenceId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "presets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exportPreset"
      }
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "modified": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "settings"
  ],
  "$defs": {
    "animatedValue": {
      "description": "Either a parameter value, or an object with a keyframes array.",
      "anyOf": [
        {
          "type": "object",
          "required": [
            "keyframes"
          ],
          "properties": {
            "keyframes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/keyframe"
              }
            }
          }
        },
        {
          "$ref": "#/$defs/paramValue"
        }
      ]
    },
    "clip": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/timeRange"
        },
        "sourceIn": {
          "$ref": "#/$defs/flicks"
        },
        "mediaId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "generatorId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequenceId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceStreamIndex": {
          "type": "integer"
        },
        "speed": {
          "anyOf": [
            {
              "$ref": "#/$defs/rational"
            },
            {
              "type": "null"
            }
          ]
        },
        "reverse": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/transform"
            },
            {
              "type": "null"
            }
          ]
        },
        "opacity": {
          "anyOf": [
            {
              "$ref": "#/$defs/animatedValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "blendMode": {
          "type": "string",
          "enum": [
            "normal",
            "add",
            "multiply",
            "screen",
            "overlay",
            "darken",
            "lighten",
            "difference"
          ]
        },
        "volume": {
          "anyOf": [
            {
              "$ref": "#/$defs/animatedValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "pan": {
          "anyOf": [
            {
              "$ref": "#/$defs/animatedValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "fadeIn": {
          "anyOf": [
            {
              "$ref": "#/$defs/fade"
            },
            {
              "type": "null"
            }
          ]
        },
        "fadeOut": {
          "anyOf": [
            {
              "$ref": "#/$defs/fade"
            },
            {
              "type": "null"
            }
          ]
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marker"
          }
        },
        "linkGroupId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "groupId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "range",
        "sourceIn"
      ]
    },
    "effect": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "typeId": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effectParameter"
          }
        },
        "maskId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "typeId",
        "enabled"
      ]
    },
    "effectParameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/animatedValue"
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "exportPreset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "settings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effectParameter"
          }
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "fade": {
      "type": "object",
      "properties": {
        "duration": {
          "$ref": "#/$defs/flicks"
        },
        "curve": {
          "type": "string",
          "enum": [
            "hold",
            "linear",
            "bezier",
            "easeIn",
            "easeOut",
            "easeInOut"
          ]
        }
      },
      "required": [
        "duration"
      ]
    },
    "flicks": {
      "type": "integer",
      "description": "A time in flicks, 1/705600000 s. One frame at 30 fps is 23520000."
    },
    "imageSequenceInfo": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer"
        },
        "count": {
          "type": "integer"
        },
        "frameRate": {
          "$ref": "#/$defs/rational"
        },
        "padding": {
          "type": "integer"
        }
      },
      "required": [
        "start",
        "count",
        "frameRate",
        "padding"
      ]
    },
    "keyframe": {
      "type": "object",
      "properties": {
        "time": {
          "$ref": "#/$defs/flicks"
        },
        "value": {
          "$ref": "#/$defs/paramValue"
        },
        "interp": {
          "type": "string",
          "enum": [
            "hold",
            "linear",
            "bezier",
            "easeIn",
            "easeOut",
            "easeInOut"
          ]
        },
        "inHandle": {
          "anyOf": [
            {
              "$ref": "#/$defs/vector2"
            },
            {
              "type": "null"
            }
          ]
        },
        "outHandle": {
          "anyOf": [
            {
              "$ref": "#/$defs/vector2"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "time",
        "value"
      ]
    },
    "marker": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/flicks"
        },
        "duration": {
          "$ref": "#/$defs/flicks"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "isChapter": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "time",
        "duration",
        "name"
      ]
    },
    "mediaInfo": {
      "type": "object",
      "properties": {
        "formatName": {
          "type": "string"
        },
        "duration": {
          "$ref": "#/$defs/flicks"
        },
        "sizeBytes": {
          "type": "integer"
        },
        "bitRate": {
          "type": "integer"
        },
        "streams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaStream"
          }
        },
        "probedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "formatName",
        "duration",
        "sizeBytes",
        "bitRate"
      ]
    },
    "mediaItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "duration": {
          "$ref": "#/$defs/flicks"
        },
        "hash": {
          "type": "string"
        },
        "proxyPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "movie",
            "still",
            "imageSequence"
          ]
        },
        "folder": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "conform": {
          "type": "string",
          "enum": [
            "fit",
            "fill",
            "stretch",
            "native"
          ]
        },
        "deinterlace": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ]
        },
        "vfrConform": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ]
        },
        "info": {
          "anyOf": [
            {
              "$ref": "#/$defs/mediaInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence": {
          "anyOf": [
            {
              "$ref": "#/$defs/imageSequenceInfo"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "relativePath",
        "name",
        "duration"
      ]
    },
    "mediaStream": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer"
        },
        "kind": {
          "type": "string",
          "enum": [
            "video",
            "audio",
            "subtitle",
            "data",
            "attachment"
          ]
        },
        "codec": {
          "type": "string"
        },
        "duration": {
          "$ref": "#/$defs/flicks"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "frameRate": {
          "anyOf": [
            {
              "$ref": "#/$defs/rational"
            },
            {
              "type": "null"
            }
          ]
        },
        "bitDepth": {
          "type": "integer"
        },
        "isInterlaced": {
          "type": "boolean"
        },
        "isVariableFrameRate": {
          "type": "boolean"
        },
        "isHdr": {
          "type": "boolean"
        },
        "hasAlpha": {
          "type": "boolean"
        },
        "sampleRate": {
          "type": "integer"
        },
        "channels": {
          "type": "integer"
        },
        "channelLayout": {
          "type": "string"
        }
      },
      "required": [
        "index",
        "kind",
        "codec",
        "duration"
      ]
    },
    "paramValue": {
      "description": "The value of an animatable parameter. A number is a float, a boolean is a bool, a string is text, an array of two or four numbers is a vector, and everything else carries a type tag.",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 4
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "float",
                "float2",
                "float4",
                "color",
                "bool",
                "int",
                "enum",
                "path",
                "text"
              ]
            }
          }
        }
      ]
    },
    "projectSettings": {
      "type": "object",
      "properties": {
        "frameRate": {
          "$ref": "#/$defs/rational"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "sampleRate": {
          "type": "integer"
        },
        "channelCount": {
          "type": "integer"
        },
        "colorSpace": {
          "type": "string"
        }
      },
      "required": [
        "frameRate",
        "width",
        "height"
      ]
    },
    "rational": {
      "type": "object",
      "description": "An exact ratio. Frame rates are written this way so that 30000/1001 stays exact.",
      "required": [
        "num",
        "den"
      ],
      "properties": {
        "num": {
          "type": "integer"
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sequence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          }
        },
        "markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marker"
          }
        },
        "settings": {
          "anyOf": [
            {
              "$ref": "#/$defs/projectSettings"
            },
            {
              "type": "null"
            }
          ]
        },
        "inOut": {
          "anyOf": [
            {
              "$ref": "#/$defs/timeRange"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "timeRange": {
      "type": "object",
      "required": [
        "start",
        "duration"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/flicks"
        },
        "duration": {
          "$ref": "#/$defs/flicks"
        }
      }
    },
    "track": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "video",
            "audio",
            "subtitle",
            "adjustment"
          ]
        },
        "name": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clip"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "locked": {
          "type": "boolean"
        },
        "muted": {
          "type": "boolean"
        },
        "solo": {
          "type": "boolean"
        },
        "height": {
          "type": "number"
        },
        "color": {
          "type": "string"
        },
        "volume": {
          "anyOf": [
            {
              "$ref": "#/$defs/animatedValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "pan": {
          "anyOf": [
            {
              "$ref": "#/$defs/animatedValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "order"
      ]
    },
    "transform": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/animatedValue"
        },
        "scale": {
          "$ref": "#/$defs/animatedValue"
        },
        "rotation": {
          "$ref": "#/$defs/animatedValue"
        },
        "anchor": {
          "$ref": "#/$defs/animatedValue"
        }
      },
      "required": [
        "position",
        "scale",
        "rotation",
        "anchor"
      ]
    },
    "transition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "typeId": {
          "type": "string"
        },
        "leftClipId": {
          "type": "string"
        },
        "rightClipId": {
          "type": "string"
        },
        "duration": {
          "$ref": "#/$defs/flicks"
        },
        "alignment": {
          "type": "string",
          "enum": [
            "centered",
            "endOfLeft",
            "startOfRight"
          ]
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effectParameter"
          }
        }
      },
      "required": [
        "id",
        "typeId",
        "leftClipId",
        "rightClipId",
        "duration",
        "alignment"
      ]
    },
    "vector2": {
      "type": "array",
      "description": "Two numbers, [x, y].",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    }
  }
}
