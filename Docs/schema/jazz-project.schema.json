        "text"
      ]
    },
    "effect": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "typeId": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effectParameter"
          }
        },
        "masks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mask"
          }
        }
      },
      "required": [
        "id",
        "typeId",
        "enabled"
      ]
    },
    "effectParameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/animatedValue"
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "effectPreset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "fade": {
      "type": "object",
      "properties": {
        "duration": {
          "$ref": "#/$defs/flicks"
        },
        "curve": {
          "type": "string",
          "enum": [
            "hold",
            "linear",
            "bezier",
            "easeIn",
            "easeOut",
            "easeInOut"
          ]
        }
      },
      "required": [
        "duration"
      ]
    },
    "flicks": {
      "type": "integer",
      "description": "A time in flicks, 1/705600000 s. One frame at 30 fps is 23520000."
    },
    "imageSequenceInfo": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer"
        },
        "count": {
          "type": "integer"
        },
        "frameRate": {
          "$ref": "#/$defs/rational"
        },
        "padding": {
          "type": "integer"
        }
      },
      "required": [
        "start",
        "count",
        "frameRate",
        "padding"
      ]
    },
    "keyframe": {
      "type": "object",
      "properties": {
        "time": {
          "$ref": "#/$defs/flicks"
        },
        "value": {
          "$ref": "#/$defs/paramValue"
        },
        "interp": {
          "type": "string",
          "enum": [
            "hold",
            "linear",
            "bezier",
            "easeIn",
            "easeOut",
            "easeInOut"
          ]
        },
        "inHandle": {
          "anyOf": [
            {
              "$ref": "#/$defs/vector2"
            },
            {
              "type": "null"
            }
          ]
        },
        "outHandle": {
          "anyOf": [
            {
              "$ref": "#/$defs/vector2"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "time",
        "value"
      ]
    },
    "marker": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/flicks"
        },
        "duration": {
          "$ref": "#/$defs/flicks"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "isChapter": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "time",
        "duration",
        "name"
      ]
    },
    "mask": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "shape": {
          "type": "string",
          "enum": [
            "rectangle",
            "ellipse",
            "polygon",
            "bezier"
          ]
