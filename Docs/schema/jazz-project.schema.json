        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "movie",
            "still",
            "imageSequence"
          ]
        },
        "folder": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "conform": {
          "type": "string",
          "enum": [
            "fit",
            "fill",
            "stretch",
            "native"
          ]
        },
        "deinterlace": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ]
        },
        "vfrConform": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
