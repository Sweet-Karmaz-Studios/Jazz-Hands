{
  // The last card of a trailer: the call to action and where to find the game.
  "name": "end-card",
  "label": "End card",
  "description": "The trailer's last card: a headline with a shine across it, a date, and two store badges, over a dark background. Name the stores and colour the badges; the text is yours to change.",
  "params": {
    "headline": { "type": "text", "default": "Wishlist now", "description": "The call to action, large." },
    "date": { "type": "text", "default": "Coming 2027", "description": "A line under it: a date, a platform." },
    "store-one": { "type": "text", "default": "Steam", "description": "The left badge." },
    "store-two": { "type": "text", "default": "Epic Games Store", "description": "The right badge." },
    "background": { "type": "color", "default": "#0D1117", "description": "Behind everything." },
    "accent": { "type": "color", "default": "#1B6FD1", "description": "The badges." },
    "duration": { "type": "time", "default": "6s", "description": "How long the card stays." }
  },
  "steps": [
    { "command": "track.add", "args": { "kind": "video", "trackId": "${id:back}" } },
    { "command": "clip.add", "args": { "trackId": "${id:back}", "at": "${at}", "generatorId": "gen.solid", "duration": "${duration}", "clipId": "${id:bg}", "name": "End card" } },
    { "command": "param.set", "args": { "ownerId": "${id:bg}", "param": "color", "value": "${background}" } },
    { "command": "track.add", "args": { "kind": "video", "trackId": "${id:left}" } },
    { "command": "clip.add", "args": { "trackId": "${id:left}", "at": "${at+0.4}", "generatorId": "gen.shape.rectangle", "duration": "${duration}", "clipId": "${id:badge-one}", "name": "Badge" } },
    { "command": "param.set", "args": { "ownerId": "${id:badge-one}", "param": "size", "value": "540, 120" } },
    { "command": "param.set", "args": { "ownerId": "${id:badge-one}", "param": "corner-radius", "value": "24" } },
    { "command": "param.set", "args": { "ownerId": "${id:badge-one}", "param": "fill", "value": "${accent}" } },
    { "command": "param.set", "args": { "ownerId": "${id:badge-one}", "param": "transform.position", "value": "-300, 250" } },
    { "command": "track.add", "args": { "kind": "video", "trackId": "${id:right}" } },
    { "command": "clip.add", "args": { "trackId": "${id:right}", "at": "${at+0.5}", "generatorId": "gen.shape.rectangle", "duration": "${duration}", "clipId": "${id:badge-two}", "name": "Badge" } },
    { "command": "param.set", "args": { "ownerId": "${id:badge-two}", "param": "size", "value": "540, 120" } },
    { "command": "param.set", "args": { "ownerId": "${id:badge-two}", "param": "corner-radius", "value": "24" } },
    { "command": "param.set", "args": { "ownerId": "${id:badge-two}", "param": "fill", "value": "${accent}" } },
    { "command": "param.set", "args": { "ownerId": "${id:badge-two}", "param": "transform.position", "value": "300, 250" } },
    { "command": "track.add", "args": { "kind": "video", "trackId": "${id:headline-track}" } },
    { "command": "title.add", "args": { "at": "${at}", "text": "${headline}", "preset": "title-card", "duration": "${duration}", "clipId": "${id:headline}", "trackId": "${id:headline-track}" } },
    { "command": "param.set", "args": { "ownerId": "${id:headline}", "param": "position", "value": "0, -170" } },
    { "command": "effect.add", "args": { "ownerId": "${id:headline}", "typeId": "video.light-sweep", "effectId": "${id:shine}" } },
    { "command": "param.set", "args": { "ownerId": "${id:shine}", "param": "trigger", "value": "0.8" } },
    { "command": "track.add", "args": { "kind": "video", "trackId": "${id:date-track}" } },
    { "command": "title.add", "args": { "at": "${at+0.2}", "text": "${date}", "preset": "caption-bold", "duration": "${duration}", "clipId": "${id:date}", "trackId": "${id:date-track}" } },
    { "command": "param.set", "args": { "ownerId": "${id:date}", "param": "position", "value": "0, 0" } },
    { "command": "param.set", "args": { "ownerId": "${id:date}", "param": "box", "value": "#00000000" } },
    { "command": "track.add", "args": { "kind": "video", "trackId": "${id:one-track}" } },
    { "command": "title.add", "args": { "at": "${at+0.4}", "text": "${store-one}", "preset": "caption-bold", "duration": "${duration}", "clipId": "${id:name-one}", "trackId": "${id:one-track}" } },
    { "command": "param.set", "args": { "ownerId": "${id:name-one}", "param": "position", "value": "-300, 250" } },
    { "command": "param.set", "args": { "ownerId": "${id:name-one}", "param": "box", "value": "#00000000" } },
    { "command": "param.set", "args": { "ownerId": "${id:name-one}", "param": "colour", "value": "#FFFFFF" } },
    { "command": "param.set", "args": { "ownerId": "${id:name-one}", "param": "size", "value": "42" } },
    { "command": "track.add", "args": { "kind": "video", "trackId": "${id:two-track}" } },
    { "command": "title.add", "args": { "at": "${at+0.5}", "text": "${store-two}", "preset": "caption-bold", "duration": "${duration}", "clipId": "${id:name-two}", "trackId": "${id:two-track}" } },
    { "command": "param.set", "args": { "ownerId": "${id:name-two}", "param": "position", "value": "300, 250" } },
    { "command": "param.set", "args": { "ownerId": "${id:name-two}", "param": "box", "value": "#00000000" } },
    { "command": "param.set", "args": { "ownerId": "${id:name-two}", "param": "colour", "value": "#FFFFFF" } },
    { "command": "param.set", "args": { "ownerId": "${id:name-two}", "param": "size", "value": "42" } }
  ],
  // Stacked for a portrait frame: the badges one over the other, under the headline.
  "portraitSteps": [
    { "command": "track.add", "args": { "kind": "video", "trackId": "${id:back}" } },
    { "command": "clip.add", "args": { "trackId": "${id:back}", "at": "${at}", "generatorId": "gen.solid", "duration": "${duration}", "clipId": "${id:bg}", "name": "End card" } },
    { "command": "param.set", "args": { "ownerId": "${id:bg}", "param": "color", "value": "${background}" } },
    { "command": "track.add", "args": { "kind": "video", "trackId": "${id:left}" } },
    { "command": "clip.add", "args": { "trackId": "${id:left}", "at": "${at+0.4}", "generatorId": "gen.shape.rectangle", "duration": "${duration}", "clipId": "${id:badge-one}", "name": "Badge" } },
    { "command": "param.set", "args": { "ownerId": "${id:badge-one}", "param": "size", "value": "760, 130" } },
    { "command": "param.set", "args": { "ownerId": "${id:badge-one}", "param": "corner-radius", "value": "24" } },
    { "command": "param.set", "args": { "ownerId": "${id:badge-one}", "param": "fill", "value": "${accent}" } },
    { "command": "param.set", "args": { "ownerId": "${id:badge-one}", "param": "transform.position", "value": "0, 120" } },
    { "command": "track.add", "args": { "kind": "video", "trackId": "${id:right}" } },
    { "command": "clip.add", "args": { "trackId": "${id:right}", "at": "${at+0.5}", "generatorId": "gen.shape.rectangle", "duration": "${duration}", "clipId": "${id:badge-two}", "name": "Badge" } },
    { "command": "param.set", "args": { "ownerId": "${id:badge-two}", "param": "size", "value": "760, 130" } },
    { "command": "param.set", "args": { "ownerId": "${id:badge-two}", "param": "corner-radius", "value": "24" } },
    { "command": "param.set", "args": { "ownerId": "${id:badge-two}", "param": "fill", "value": "${accent}" } },
    { "command": "param.set", "args": { "ownerId": "${id:badge-two}", "param": "transform.position", "value": "0, 290" } },
    { "command": "track.add", "args": { "kind": "video", "trackId": "${id:headline-track}" } },
    { "command": "title.add", "args": { "at": "${at}", "text": "${headline}", "preset": "title-card", "duration": "${duration}", "clipId": "${id:headline}", "trackId": "${id:headline-track}" } },
    { "command": "param.set", "args": { "ownerId": "${id:headline}", "param": "position", "value": "0, -420" } },
    { "command": "effect.add", "args": { "ownerId": "${id:headline}", "typeId": "video.light-sweep", "effectId": "${id:shine}" } },
    { "command": "param.set", "args": { "ownerId": "${id:shine}", "param": "trigger", "value": "0.8" } },
    { "command": "track.add", "args": { "kind": "video", "trackId": "${id:date-track}" } },
    { "command": "title.add", "args": { "at": "${at+0.2}", "text": "${date}", "preset": "caption-bold", "duration": "${duration}", "clipId": "${id:date}", "trackId": "${id:date-track}" } },
    { "command": "param.set", "args": { "ownerId": "${id:date}", "param": "position", "value": "0, -250" } },
    { "command": "param.set", "args": { "ownerId": "${id:date}", "param": "box", "value": "#00000000" } },
    { "command": "track.add", "args": { "kind": "video", "trackId": "${id:one-track}" } },
    { "command": "title.add", "args": { "at": "${at+0.4}", "text": "${store-one}", "preset": "caption-bold", "duration": "${duration}", "clipId": "${id:name-one}", "trackId": "${id:one-track}" } },
    { "command": "param.set", "args": { "ownerId": "${id:name-one}", "param": "position", "value": "0, 120" } },
    { "command": "param.set", "args": { "ownerId": "${id:name-one}", "param": "box", "value": "#00000000" } },
    { "command": "param.set", "args": { "ownerId": "${id:name-one}", "param": "colour", "value": "#FFFFFF" } },
    { "command": "param.set", "args": { "ownerId": "${id:name-one}", "param": "size", "value": "50" } },
    { "command": "track.add", "args": { "kind": "video", "trackId": "${id:two-track}" } },
    { "command": "title.add", "args": { "at": "${at+0.5}", "text": "${store-two}", "preset": "caption-bold", "duration": "${duration}", "clipId": "${id:name-two}", "trackId": "${id:two-track}" } },
    { "command": "param.set", "args": { "ownerId": "${id:name-two}", "param": "position", "value": "0, 290" } },
    { "command": "param.set", "args": { "ownerId": "${id:name-two}", "param": "box", "value": "#00000000" } },
    { "command": "param.set", "args": { "ownerId": "${id:name-two}", "param": "colour", "value": "#FFFFFF" } },
    { "command": "param.set", "args": { "ownerId": "${id:name-two}", "param": "size", "value": "50" } }
  ]
}
