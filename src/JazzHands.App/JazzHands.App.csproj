<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>JazzHands</AssemblyName>
    <Description>The Jazz Hands WPF application.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Spike windows are throwaway harnesses under Spikes/. They are compiled in Debug, and in
       Release only when asked for, so a spike can be measured on an optimised build without
       shipping in a normal one. See Docs/SPIKES.md. -->
  <PropertyGroup>
    <JazzSpikes Condition="'$(JazzSpikes)' == '' and '$(Configuration)' == 'Debug'">true</JazzSpikes>
    <JazzSpikes Condition="'$(JazzSpikes)' == ''">false</JazzSpikes>
    <DefineConstants Condition="'$(JazzSpikes)' == 'true'">$(DefineConstants);SPIKES</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(JazzSpikes)' != 'true'">
    <Compile Remove="Spikes\**\*.cs" />
    <Page Remove="Spikes\**\*.xaml" />
    <None Include="Spikes\**\*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JazzHands.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The default key bindings. A keymap.json in %APPDATA%\JazzHands overrides them key by key. -->
    <EmbeddedResource Include="Input\keymap.json" LogicalName="JazzHands.App.Input.keymap.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JazzHands.Control\JazzHands.Control.csproj" />
    <ProjectReference Include="..\JazzHands.Engine\JazzHands.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dirkster.AvalonDock" />
    <PackageReference Include="Dirkster.AvalonDock.Serializer.Xml" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <!-- The preview bridge needs D3D9Ex to hand a shared D3D11 texture to WPF's compositor. -->
    <PackageReference Include="Vortice.Direct3D9" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.Direct2D1" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>

</Project>
