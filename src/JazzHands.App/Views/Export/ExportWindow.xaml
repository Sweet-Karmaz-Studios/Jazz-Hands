<Window x:Class="JazzHands.App.Views.Export.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JazzHands.App.ViewModels.Export"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ExportDialogViewModel}"
        Title="{Binding Heading, Mode=OneWay}"
        Height="780"
        Width="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background.Panel}"
        Foreground="{DynamicResource Brush.Text.Primary}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>

    <Grid Margin="16" TextElement.Foreground="{DynamicResource Brush.Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="File" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" />
        <TextBox Grid.Row="0"
                 Grid.Column="1"
                 Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                 Background="{DynamicResource Brush.Background.Input}"
                 Foreground="{DynamicResource Brush.Text.Primary}"
                 CaretBrush="{DynamicResource Brush.Text.Primary}"
                 BorderBrush="{DynamicResource Brush.Border}"
                 Padding="4,2"
                 AutomationProperties.Name="Output file" />
        <Button Grid.Row="0"
                Grid.Column="2"
                Margin="8,0,0,0"
                Style="{StaticResource Button.Secondary}"
                Content="Browse..."
                Command="{Binding BrowseCommand, Mode=OneWay}"
                AutomationProperties.Name="Browse for the output file" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,16,0,0" Text="Preset" VerticalAlignment="Top" Foreground="{DynamicResource Brush.Text.Secondary}" />
        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <ComboBox Style="{StaticResource ComboBox.Compact}"
                      HorizontalAlignment="Left"
                      Width="240"
                      ItemsSource="{Binding Presets, Mode=OneWay}"
                      SelectedItem="{Binding Preset, Mode=TwoWay}"
                      AutomationProperties.Name="Preset">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label, Mode=OneWay}" ToolTip="{Binding Name, Mode=OneWay}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Margin="0,6,0,0"
                       Text="{Binding Preset.Summary, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
            <TextBlock Margin="0,2,0,0"
                       Text="{Binding Preset.Description, Mode=OneWay}"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource Text.Caption}"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,16,0,0" Text="Mode" VerticalAlignment="Top" Foreground="{DynamicResource Brush.Text.Secondary}" />
        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <ComboBox Style="{StaticResource ComboBox.Compact}"
                      ItemsSource="{Binding ModeChoices, Mode=OneWay}"
                      SelectedValuePath="Mode"
                      SelectedValue="{Binding Mode, Mode=TwoWay}"
                      HorizontalAlignment="Left"
                      MinWidth="160"
                      MaxWidth="520"
                      AutomationProperties.Name="Mode">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ExportModeChoice}">
                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Label, Mode=OneTime}">
                            <TextBlock Text="{Binding Label, Mode=OneTime}" />
                            <TextBlock x:Name="Note"
                                       Margin="8,0,0,0"
                                       Text="{Binding Note, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="400"
                                       ToolTip="{Binding Note, Mode=OneWay}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsAvailable, Mode=OneWay}" Value="False">
                                <Setter TargetName="Note" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Margin="0,6,0,0"
                       Text="{Binding ModeExplanation, Mode=OneWay}"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource Text.Caption}"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <CheckBox Content="Move cuts to the nearest keyframe when copying"
                      IsChecked="{Binding SnapToKeyframes, Mode=TwoWay}"
                      Foreground="{DynamicResource Brush.Text.Primary}"
                      AutomationProperties.Name="Snap to keyframes" />
            <CheckBox Margin="0,4,0,0"
                      Content="Only between the in and out points"
                      IsChecked="{Binding UseInOut, Mode=TwoWay}"
                      Foreground="{DynamicResource Brush.Text.Primary}"
                      AutomationProperties.Name="Use in and out" />
            <CheckBox Margin="0,4,0,0"
                      Content="Encode through ffmpeg.exe (for checking an encoder problem)"
                      IsChecked="{Binding UseExternalFfmpeg, Mode=TwoWay}"
                      Foreground="{DynamicResource Brush.Text.Primary}"
                      AutomationProperties.Name="Use external ffmpeg" />
            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Left" Text="Subtitles" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <ComboBox Style="{StaticResource ComboBox.Compact}"
                          HorizontalAlignment="Left"
                          Width="260"
                          ItemsSource="{Binding Source={x:Static vm:ExportDialogViewModel.SubtitleChoices}, Mode=OneTime}"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding Subtitles, Mode=TwoWay}"
                          AutomationProperties.Name="Subtitles">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label, Mode=OneWay}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>
            <CheckBox Margin="0,4,0,0"
                      Content="Chapters from the chapter marks"
                      IsChecked="{Binding Chapters, Mode=TwoWay}"
                      Foreground="{DynamicResource Brush.Text.Primary}"
                      AutomationProperties.Name="Chapters" />
        </StackPanel>


        <!-- Changes to the preset for this export, in the words the command line takes. -->
        <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <ToggleButton HorizontalAlignment="Left"
                          Style="{StaticResource Button.Text}"
                          Content="Change the preset for this export..."
                          IsChecked="{Binding ShowOverrides, Mode=TwoWay}"
                          AutomationProperties.Name="Show the preset overrides" />
            <Grid Margin="0,8,0,0" Visibility="{Binding ShowOverrides, Converter={StaticResource Visible}, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                    </Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.Hinted}">
                        <Setter Property="Margin" Value="0,2,12,2" />
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Size" />
                <TextBox Grid.Row="0" Grid.Column="1" Tag="{Binding Hints.Size, Mode=OneWay}" Text="{Binding SizeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Fit inside this size, never scaling up: 3840x2160, 1920x1080, 1280x720, 854x480"
                         AutomationProperties.Name="Size" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Frame rate" />
                <TextBox Grid.Row="0" Grid.Column="3" Tag="{Binding Hints.FrameRate, Mode=OneWay}" Text="{Binding FrameRateText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip="60, 50, 30, 30000/1001, 25, 24, 15"
                         AutomationProperties.Name="Frame rate" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Quality" />
                <TextBox Grid.Row="1" Grid.Column="1" Tag="{Binding Hints.Quality, Mode=OneWay}" Text="{Binding QualityText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Constant quality, CRF or CQ: lower is better, about 18 to 23 for delivery"
                         AutomationProperties.Name="Quality" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Bitrate" />
                <TextBox Grid.Row="1" Grid.Column="3" Tag="{Binding Hints.Bitrate, Mode=OneWay}" Text="{Binding BitrateText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip="A picture bitrate instead of constant quality: 8M, 2500k"
                         AutomationProperties.Name="Bitrate" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Encoders" />
                <TextBox Grid.Row="2" Grid.Column="1" Tag="{Binding Hints.Encoders, Mode=OneWay}" Text="{Binding EncodersText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip="The encoders to try in order: hevc_nvenc,libx265"
                         AutomationProperties.Name="Encoders" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Colour" />
                <TextBox Grid.Row="2" Grid.Column="3" Tag="{Binding Hints.PixelFormat, Mode=OneWay}" Text="{Binding PixelFormatText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip="The pixel format: yuv420p, yuv420p10le for ten bits, yuv422p10le. BT.709 SDR either way."
                         AutomationProperties.Name="Pixel format" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Sound" />
                <TextBox Grid.Row="3" Grid.Column="1" Tag="{Binding Hints.Sound, Mode=OneWay}" Text="{Binding AudioEncoderText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip="aac, libopus, flac, eac3, ac3, libmp3lame, pcm_s24le"
                         AutomationProperties.Name="Sound encoder" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Sound bitrate" />
                <TextBox Grid.Row="3" Grid.Column="3" Tag="{Binding Hints.SoundBitrate, Mode=OneWay}" Text="{Binding AudioBitrateText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip="320k"
                         AutomationProperties.Name="Sound bitrate" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Channels" />
                <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,2,12,2"
                          Style="{StaticResource ComboBox.Compact}"
                          ItemsSource="{Binding Source={x:Static vm:ExportDialogViewModel.ChannelChoices}, Mode=OneTime}"
                          SelectedItem="{Binding Channels, Mode=TwoWay}"
                          AutomationProperties.Name="Channels">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label, Mode=OneWay}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="Under" />
                <TextBox Grid.Row="4" Grid.Column="3" Tag="{Binding Hints.Under, Mode=OneWay}" Text="{Binding TargetSizeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Come in under this size, with a smaller picture when it must: 8MB, 25MB"
                         AutomationProperties.Name="Target size" />

                <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,4"
                          VerticalAlignment="Center"
                          Content="Normalise the loudness to"
                          IsChecked="{Binding Normalise, Mode=TwoWay}"
                          Foreground="{DynamicResource Brush.Text.Primary}"
                          AutomationProperties.Name="Normalise the loudness" />
                <TextBlock Grid.Row="5" Grid.Column="2" Text="LUFS" />
                <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding LoudnessText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         IsEnabled="{Binding Normalise, Mode=OneWay}"
                         ToolTip="-14 for YouTube and Spotify, -16 for Apple, -23 for broadcast"
                         AutomationProperties.Name="Loudness target" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="From" />
                <TextBox Grid.Row="6" Grid.Column="1" Tag="{Binding Hints.From, Mode=OneWay}" Text="{Binding StartText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Export from here, in sequence time: 00:00:10.000"
                         AutomationProperties.Name="Export from" />
                <TextBlock Grid.Row="6" Grid.Column="2" Text="To" />
                <TextBox Grid.Row="6" Grid.Column="3" Tag="{Binding Hints.To, Mode=OneWay}" Text="{Binding EndText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Export to here, in sequence time: 00:01:30.000"
                         AutomationProperties.Name="Export to" />

                <DockPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource Button.Text}"
                            Content="Reset"
                            Command="{Binding ResetOverridesCommand, Mode=OneWay}"
                            AutomationProperties.Name="Reset the overrides" />
                    <CheckBox DockPanel.Dock="Left" Margin="0,0,16,0"
                              VerticalAlignment="Center"
                              Content="Sound only"
                              IsChecked="{Binding SoundOnly, Mode=TwoWay}"
                              ToolTip="Write the mix alone: AAC in .m4a, Opus in .opus, FLAC, WAV or MP3, by the preset's sound"
                              Foreground="{DynamicResource Brush.Text.Primary}"
                              AutomationProperties.Name="Sound only" />
                    <TextBlock DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center" Text="Stems" />
                    <ComboBox DockPanel.Dock="Left" Margin="0,0,16,0" MinWidth="130"
                              Style="{StaticResource ComboBox.Compact}"
                              ItemsSource="{Binding Source={x:Static vm:ExportDialogViewModel.StemChoices}, Mode=OneTime}"
                              SelectedItem="{Binding Stems, Mode=TwoWay}"
                              ToolTip="Also write a 24-bit WAV per role (dialogue, music, effects, game) or per sound track beside the file, adding up to the mix"
                              AutomationProperties.Name="Stems">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label, Mode=OneWay}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="An empty box keeps the preset's value, shown in it."
                               FontSize="{DynamicResource Text.Caption}" />
                </DockPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <TextBlock Text="{Binding Summary, Mode=OneWay}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,2,0,0"
                       Text="{Binding Estimate, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
        </StackPanel>

        <!-- The planner's reasons, in its own words, or why nothing can be planned. -->
        <Border Grid.Row="6"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="0,8,0,0"
                Padding="8"
                Background="{DynamicResource Brush.Background.Base}">
            <StackPanel>
                <TextBlock Text="Working it out..."
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Visibility="{Binding IsPlanning, Converter={StaticResource Visible}, Mode=OneWay}" />
                <TextBlock Text="{Binding Error, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Warning}" />
                <ItemsControl ItemsSource="{Binding Reasons, Mode=OneWay}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Mode=OneWay}"
                                       Margin="0,0,0,4"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Button.Secondary}"
                    Content="Cancel"
                    IsCancel="True"
                    Command="{Binding CancelCommand, Mode=OneWay}"
                    AutomationProperties.Name="Cancel" />
            <Button Style="{StaticResource Button.Primary}"
                    Margin="8,0,0,0"
                    Content="Add to queue"
                    IsDefault="True"
                    Command="{Binding ExportCommand, Mode=OneWay}"
                    AutomationProperties.Name="Add to the export queue" />
            <Button Style="{StaticResource Button.Secondary}"
                    Margin="8,0,0,0"
                    Content="Export now"
                    Command="{Binding ExportNowCommand, Mode=OneWay}"
                    ToolTip="Ahead of everything waiting, so it starts as soon as a slot is free"
                    AutomationProperties.Name="Export now" />
        </StackPanel>
    </Grid>
</Window>
