<UserControl x:Class="JazzHands.App.Views.Export.ExportQueuePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JazzHands.App.ViewModels.Export"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ExportQueuePanelViewModel}"
             d:DesignWidth="380"
             d:DesignHeight="300"
             Background="{DynamicResource Brush.Background.Panel}">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status, Mode=OneWay}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource Text.Caption}"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
            <Button Grid.Column="1"
                    Style="{StaticResource Button.Icon}"
                    Content="&#xE769;"
                    Command="{Binding PauseAllCommand, Mode=OneWay}"
                    ToolTip="Pause every export"
                    AutomationProperties.Name="Pause every export" />
            <Button Grid.Column="2"
                    Style="{StaticResource Button.Icon}"
                    Content="&#xE768;"
                    Command="{Binding ResumeAllCommand, Mode=OneWay}"
                    ToolTip="Resume every paused export"
                    AutomationProperties.Name="Resume every paused export" />
            <Button Grid.Column="3"
                    Style="{StaticResource Button.Text}"
                    Content="Clear finished"
                    Command="{Binding ClearFinishedCommand, Mode=OneWay}"
                    AutomationProperties.Name="Clear finished exports" />
        </Grid>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Jobs, Mode=OneWay}"
                 SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                 Background="{DynamicResource Brush.Background.Base}"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Export jobs">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ExportJobViewModel}">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{Binding Name, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding OutputPath, Mode=OneWay}"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Margin="8,0"
                                   Text="{Binding StateText, Mode=OneWay}"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="{DynamicResource Text.Caption}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource Button.Icon}"
                                    Content="&#xE74A;"
                                    Command="{Binding RaiseCommand, Mode=OneWay}"
                                    ToolTip="Move to the front of the queue, or back"
                                    AutomationProperties.Name="Change priority" />
                            <Button Style="{StaticResource Button.Icon}"
                                    Content="{Binding PauseGlyph, Mode=OneWay}"
                                    Command="{Binding PauseOrResumeCommand, Mode=OneWay}"
                                    ToolTip="{Binding PauseText, Mode=OneWay}"
                                    AutomationProperties.Name="{Binding PauseText, Mode=OneWay}" />
                            <Button Style="{StaticResource Button.Icon}"
                                    Content="&#xE838;"
                                    Command="{Binding ShowInFolderCommand, Mode=OneWay}"
                                    ToolTip="Show in its folder"
                                    AutomationProperties.Name="Show in folder" />
                            <Button Style="{StaticResource Button.Icon}"
                                    Content="&#xE711;"
                                    Command="{Binding CancelCommand, Mode=OneWay}"
                                    ToolTip="Stop this export"
                                    AutomationProperties.Name="Cancel export" />
                        </StackPanel>

                        <ProgressBar Grid.Row="1"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     Height="4"
                                     Margin="0,4,8,0"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     Background="{DynamicResource Brush.Background.Raised}"
                                     Foreground="{DynamicResource Brush.Accent}"
                                     BorderThickness="0"
                                     AutomationProperties.Name="Export progress" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Margin="0,2,8,0"
                                   Text="{Binding Detail, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource Text.Caption}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFailed, Mode=OneWay}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                Margin="0,8,0,0"
                Padding="6"
                MaxHeight="140"
                Background="{DynamicResource Brush.Background.Base}"
                AutomationProperties.Name="Export log">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedJob, Mode=OneWay}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Log, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="{DynamicResource Text.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
