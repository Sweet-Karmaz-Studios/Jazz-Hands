<Window x:Class="JazzHands.App.Views.Settings.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height"
        Width="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background.Panel}"
        Foreground="{DynamicResource Brush.Text.Primary}">
    <StackPanel Margin="16">
        <TextBlock x:Name="Prompt" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" />
        <TextBox x:Name="Input" AutomationProperties.Name="Answer" />
        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Button.Text}" Content="Cancel" IsCancel="True" AutomationProperties.Name="Cancel" />
            <Button Style="{StaticResource Button.Primary}" Margin="8,0,0,0" Content="OK" IsDefault="True" Click="OnOk" AutomationProperties.Name="OK" />
        </StackPanel>
    </StackPanel>
</Window>
