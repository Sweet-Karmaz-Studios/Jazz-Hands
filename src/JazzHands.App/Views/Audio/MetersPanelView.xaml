<UserControl x:Class="JazzHands.App.Views.Audio.MetersPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JazzHands.App.ViewModels.Audio"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MetersPanelViewModel}"
             Background="{DynamicResource Brush.Background.Panel}">

    <UserControl.Resources>
        <!-- A level bar that fills from the bottom. The ProgressBar sizes its indicator itself, so
             a level is a bound Value rather than a transform, and the template is turned on its
             side so that filling left to right becomes filling bottom to top. -->
        <Style x:Key="MeterBar" TargetType="{x:Type ProgressBar}">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid>
                            <Grid.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </Grid.LayoutTransform>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- A bar per channel: the RMS level solid, the peak a lighter bar behind it. The held peak is
         the number underneath, red once it reaches full scale. -->
    <Grid Margin="{DynamicResource Space.Normal}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The scale, linear in dB from -60 at the bottom to 0 at the top. -->
        <!-- Its bottom margin is the two 20 px label rows under each bar, so -60 sits on the
             bottom of the bars and 0 on the top. -->
        <Grid Grid.Column="0" Grid.Row="0" Margin="0,0,6,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="0" VerticalAlignment="Top" HorizontalAlignment="Right"
                       FontSize="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" />
            <TextBlock Grid.Row="1" Text="-12" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-7,0,0"
                       FontSize="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" />
            <TextBlock Grid.Row="2" Text="-24" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-7,0,0"
                       FontSize="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" />
            <TextBlock Grid.Row="3" Text="-36" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-7,0,0"
                       FontSize="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" />
            <TextBlock Grid.Row="4" Text="-48" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-7,0,0"
                       FontSize="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" />
            <TextBlock Grid.Row="4" Text="-60" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                       FontSize="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" />
        </Grid>

        <ItemsControl Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" ItemsSource="{Binding Channels, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MeterChannelViewModel}">
                    <Grid Margin="2,0" MaxWidth="40">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource Brush.Background.Input}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Grid>
                                <ProgressBar x:Name="PeakBar" Style="{StaticResource MeterBar}" Foreground="{DynamicResource Brush.Label.Blue}"
                                             Opacity="0.45" Value="{Binding PeakLevel, Mode=OneWay}" />
                                <ProgressBar Style="{StaticResource MeterBar}" Foreground="{DynamicResource Brush.Accent}" Margin="3,0"
                                             Value="{Binding RmsLevel, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <TextBlock x:Name="Hold" Grid.Row="1" Text="{Binding HoldText, Mode=OneWay}" HorizontalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="{Binding Name, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="{DynamicResource Text.Caption}" />
                    </Grid>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsClipping, Mode=OneWay}" Value="True">
                            <Setter TargetName="PeakBar" Property="Foreground" Value="{DynamicResource Brush.Error}" />
                            <Setter TargetName="PeakBar" Property="Opacity" Value="1" />
                            <Setter TargetName="Hold" Property="Foreground" Value="{DynamicResource Brush.Error}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
