<Window x:Class="JazzHands.App.Views.Media.SceneCutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JazzHands.App.ViewModels.Media"
        xmlns:local="clr-namespace:JazzHands.App.Views.Media"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SceneCutsViewModel}"
        Title="{Binding Title, Mode=OneWay}"
        Width="720"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background.Panel}"
        Foreground="{DynamicResource Brush.Text.Primary}">
    <Window.Resources>
        <local:FractionOfWidthConverter x:Key="FractionOfWidth" />
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>
    <StackPanel x:Name="Root" Margin="16" Background="{DynamicResource Brush.Background.Panel}">
        <TextBlock Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   Text="Finds where the shots change in an edited video: a finished trailer, an old render, a compilation. Nothing changes until you choose what to do with them." />
        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="{Binding TargetName, Mode=OneWay}" />

        <!-- The strip, in source order, with the cuts drawn over it: blue for a cut, amber for a dissolve. -->
        <Grid x:Name="Strip" Height="54" Margin="0,0,0,4" Background="{DynamicResource Brush.Background.Raised}">
            <ItemsControl ItemsSource="{Binding Tiles, Mode=OneWay}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding Mode=OneWay}" Stretch="UniformToFill" Margin="0,0,1,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Marks, Mode=OneWay}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource FractionOfWidth}">
                                    <Binding Path="Fraction" Mode="OneWay" />
                                    <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}" Path="ActualWidth" Mode="OneWay" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SceneCutMark}">
                        <Rectangle x:Name="Mark" Width="3" Height="54" Margin="-1,0,0,0" Fill="{DynamicResource Brush.Accent}" ToolTip="{Binding Tip, Mode=OneWay}" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDissolve, Mode=OneWay}" Value="True">
                                <Setter TargetName="Mark" Property="Fill" Value="{DynamicResource Brush.Warning}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        <ProgressBar Height="4"
                     Margin="0,0,0,4"
                     Minimum="0"
                     Maximum="1"
                     Value="{Binding Progress, Mode=OneWay}"
                     Visibility="{Binding IsReading, Mode=OneWay, Converter={StaticResource Visible}}"
                     Background="{DynamicResource Brush.Background.Raised}"
                     Foreground="{DynamicResource Brush.Accent}"
                     BorderThickness="0"
                     AutomationProperties.Name="Reading progress" />
        <TextBlock Margin="0,0,0,12" Text="{Binding Found, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Secondary}" />

        <DockPanel Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Width="110" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" Text="Threshold" />
            <TextBlock DockPanel.Dock="Right" Width="40" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontFamily="Cascadia Mono" Text="{Binding Threshold, Mode=OneWay, StringFormat={}{0:0}}" />
            <Slider Minimum="1"
                    Maximum="50"
                    SmallChange="1"
                    LargeChange="5"
                    IsSnapToTickEnabled="True"
                    TickFrequency="1"
                    VerticalAlignment="Center"
                    Value="{Binding Threshold, Mode=TwoWay}"
                    ToolTip="How much of the picture has to change for a cut; lower finds more"
                    AutomationProperties.Name="Threshold" />
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Width="110" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" Text="Shortest shot (s)" />
            <TextBox Width="60" HorizontalAlignment="Left" Text="{Binding MinShotSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="A cut closer than this to the last is dropped, keeping the stronger" AutomationProperties.Name="Shortest shot in seconds" />
        </DockPanel>

        <TextBlock Margin="0,4,0,0" Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" />
        <StackPanel Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Button.Secondary}" Content="Cancel" IsCancel="True" Command="{Binding CancelCommand, Mode=OneWay}" AutomationProperties.Name="Cancel" />
            <Button Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Content="Add markers" Command="{Binding MarkCommand, Mode=OneWay}" ToolTip="A marker at every cut; running it again replaces them" AutomationProperties.Name="Add markers at the cuts" />
            <Button Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Content="Make subclips" Command="{Binding SubclipsCommand, Mode=OneWay}" Visibility="{Binding IsMedia, Mode=OneWay, Converter={StaticResource Visible}}" ToolTip="A subclip of every shot, in a folder named after the file" AutomationProperties.Name="Make a subclip of every shot" />
            <Button Style="{StaticResource Button.Primary}" Margin="8,0,0,0" Content="Split" IsDefault="True" Command="{Binding SplitCommand, Mode=OneWay}" Visibility="{Binding IsClip, Mode=OneWay, Converter={StaticResource Visible}}" ToolTip="Split the clip and its linked sound at every cut: one undo" AutomationProperties.Name="Split the clip at the cuts" />
        </StackPanel>
    </StackPanel>
</Window>
