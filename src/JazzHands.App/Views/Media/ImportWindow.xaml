<Window x:Class="JazzHands.App.Views.Media.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JazzHands.App.ViewModels.Media"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ImportViewModel}"
        Title="Import media"
        Height="520"
        Width="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background.Panel}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Files" Foreground="{DynamicResource Brush.Text.Secondary}">
            <ListBox ItemsSource="{Binding Files, Mode=OneWay}"
                     Background="{DynamicResource Brush.Background.Base}"
                     BorderThickness="0"
                     Foreground="{DynamicResource Brush.Text.Primary}" />
        </GroupBox>

        <!-- Conform defaults. Changing one re-reads the files, because a warning's wording
             depends on what is about to be done about it. -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Fit" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Grid.Column="1"
                      Margin="0,0,12,0"
                      ItemsSource="{Binding Source={x:Static vm:ImportViewModel.ConformPolicies}, Mode=OneTime}"
                      SelectedItem="{Binding Conform, Mode=TwoWay}" />

            <TextBlock Grid.Column="2" Text="Deinterlace" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Grid.Column="3"
                      Margin="0,0,12,0"
                      ItemsSource="{Binding Source={x:Static vm:ImportViewModel.AutoSettings}, Mode=OneTime}"
                      SelectedItem="{Binding Deinterlace, Mode=TwoWay}" />

            <TextBlock Grid.Column="4" Text="Conform frame rate" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Grid.Column="5"
                      ItemsSource="{Binding Source={x:Static vm:ImportViewModel.AutoSettings}, Mode=OneTime}"
                      SelectedItem="{Binding VfrConform, Mode=TwoWay}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Bin folder" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" Margin="0,0,12,0" Text="{Binding Folder, Mode=TwoWay}" />

            <TextBlock Grid.Column="2" Text="Tags" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="3" Margin="0,0,12,0" Text="{Binding Tags, Mode=TwoWay}" />

            <CheckBox Grid.Column="4"
                      Content="Look in sub-folders"
                      VerticalAlignment="Center"
                      IsChecked="{Binding Recursive, Mode=TwoWay}" />
        </Grid>

        <GroupBox Grid.Row="3"
                  Margin="0,12,0,0"
                  Header="{Binding WarningSummary, Mode=OneWay}"
                  Foreground="{DynamicResource Brush.Text.Secondary}">
            <ListBox ItemsSource="{Binding Warnings, Mode=OneWay}"
                     Background="{DynamicResource Brush.Background.Base}"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ImportWarningViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding File, Mode=OneWay}"
                                       Width="180"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBlock Text="{Binding Message, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Error}"
                       Text="{Binding Status, Mode=OneWay}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Text}"
                        Content="Cancel"
                        MinWidth="72"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Command="{Binding CancelCommand, Mode=OneWay}" />
                <Button Style="{StaticResource Button.Primary}"
                        Content="Import"
                        IsDefault="True"
                        Command="{Binding ImportCommand, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
