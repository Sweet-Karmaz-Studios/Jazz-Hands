<UserControl x:Class="JazzHands.App.Views.Media.MediaPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JazzHands.App.ViewModels.Media"
             xmlns:views="clr-namespace:JazzHands.App.Views.Media"
             d:DataContext="{d:DesignInstance vm:MediaPanelViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Brush.Background.Panel}"
             AllowDrop="True"
             DragEnter="OnFilesOver"
             DragOver="OnFilesOver"
             Drop="OnFilesDropped">

    <UserControl.Resources>
        <views:ColorLabelConverter x:Key="ColorLabel" />
        <views:EnumMatchConverter x:Key="EnumMatch" />
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1">
            <!-- Files missing or changed on disk: say so, with the way to fix it. -->
            <Border Margin="6,0,6,6"
                    Padding="8,6"
                    Background="{DynamicResource Brush.Background.Raised}"
                    BorderBrush="{DynamicResource Brush.Error}"
                    BorderThickness="2,0,0,0"
                    Visibility="{Binding HasLibraryNotice, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Margin="6,0,0,0"
                            Content="Update"
                            ToolTip="Read the changed files again"
                            Command="{Binding UpdateChangedCommand, Mode=OneWay}"
                            Visibility="{Binding HasChanged, Mode=OneWay, Converter={StaticResource BoolToVisible}}" />
                    <Button DockPanel.Dock="Right"
                            Margin="6,0,0,0"
                            Content="Find them..."
                            Command="{Binding FindMissingCommand, Mode=OneWay}"
                            Visibility="{Binding HasMissing, Mode=OneWay, Converter={StaticResource BoolToVisible}}" />
                    <TextBlock Text="{Binding LibraryNotice, Mode=OneWay}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- Heavy footage just imported: offer proxies, once, and get out of the way. -->
            <Border Margin="6,0,6,6"
                    Padding="8,6"
                    Background="{DynamicResource Brush.Background.Raised}"
                    BorderBrush="{DynamicResource Brush.Accent}"
                    BorderThickness="2,0,0,0"
                    Visibility="{Binding HasProxySuggestion, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Margin="6,0,0,0"
                            Content="Not now"
                            Command="{Binding DismissProxySuggestionCommand, Mode=OneWay}" />
                    <Button DockPanel.Dock="Right"
                            Margin="6,0,0,0"
                            Content="Make proxies"
                            Command="{Binding MakeSuggestedProxiesCommand, Mode=OneWay}" />
                    <TextBlock Text="{Binding ProxySuggestion, Mode=OneWay}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Toolbar: import, view mode, and the search box the exit criteria are about. -->
        <Grid Grid.Row="0" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Import..."
                    Command="{Binding ImportCommand, Mode=OneWay}" />

            <TextBox Grid.Column="1"
                     x:Name="SearchBox"
                     Margin="6,0"
                     VerticalContentAlignment="Center"
                     Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search names, tags, folders, codecs and stream titles."
                     AutomationProperties.Name="Search media" />
            <TextBlock Grid.Column="1"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Text="Search media"
                       Foreground="{DynamicResource Brush.Text.Disabled}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Search, Mode=OneWay}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <RadioButton Content="List"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.Text.Secondary}"
                             IsChecked="{Binding ViewMode, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter=List}" />
                <RadioButton Content="Grid"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.Text.Secondary}"
                             IsChecked="{Binding ViewMode, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter=Grid}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" MinWidth="80" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The folder tree, derived from the folder on each item. -->
            <TreeView Grid.Column="0"
                      x:Name="FolderTree"
                      Background="{DynamicResource Brush.Background.Base}"
                      BorderBrush="{DynamicResource Brush.Border}"
                      ItemsSource="{Binding Folders, Mode=OneWay}"
                      SelectedItemChanged="OnFolderSelected">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:MediaFolderViewModel}"
                                              ItemsSource="{Binding Children, Mode=OneWay}">
                        <TextBlock Text="{Binding Label, Mode=OneWay}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource Brush.Border}" />

            <!-- List mode: the columns the phase prompt asks for. -->
            <ListView Grid.Column="2"
                      x:Name="ItemList"
                      AutomationProperties.Name="Media"
                      Background="{DynamicResource Brush.Background.Base}"
                      BorderBrush="{DynamicResource Brush.Border}"
                      Foreground="{DynamicResource Brush.Text.Primary}"
                      ItemsSource="{Binding Items, Mode=OneWay}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      SelectionMode="Extended"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      PreviewMouseLeftButtonDown="OnListMouseDown"
                      MouseMove="OnListMouseMove"
                      MouseDoubleClick="OnItemDoubleClick"
                      Visibility="{Binding IsListMode, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Quick Trim" Command="{Binding QuickTrimCommand, Mode=OneWay}" ToolTip="Keep and cut stretches of this recording in a sequence of its own" />
                        <Separator />
                        <MenuItem Header="Open in source monitor" Command="{Binding OpenInSourceCommand, Mode=OneWay}" InputGestureText="Double-click" ToolTip="Mark in and out on it, then insert or overwrite into the sequence" />
                        <MenuItem Header="Find scene cuts..." Command="{Binding FindSceneCutsCommand, Mode=OneWay}" ToolTip="Find where the shots change in an edited video, then mark them or make a subclip of each" />
                        <MenuItem Header="Reveal in Explorer" Command="{Binding RevealCommand, Mode=OneWay}" />
                        <MenuItem Header="Re-read from disk" Command="{Binding ReprobeCommand, Mode=OneWay}" />
                        <MenuItem Header="Generate proxy" Command="{Binding GenerateProxyCommand, Mode=OneWay}" />
                        <MenuItem Header="Relink to a file..." Command="{Binding RelinkSelectedCommand, Mode=OneWay}" ToolTip="The file moved: point this item at where it is now" />
                        <MenuItem Header="Replace file..." Command="{Binding ReplaceSelectedCommand, Mode=OneWay}" ToolTip="Swap in another file, keeping every clip made from this one" />
                        <Separator />
                        <MenuItem Header="Find missing media..." Command="{Binding FindMissingCommand, Mode=OneWay}" />
                        <MenuItem Header="Remove unused media" Command="{Binding RemoveUnusedCommand, Mode=OneWay}" ToolTip="Take out every item no clip uses (undoable)" />
                        <MenuItem Header="Watch a folder..." Command="{Binding WatchFolderCommand, Mode=OneWay}" ToolTip="Bring in new recordings from a captures folder as they finish" />
                        <MenuItem Header="Stop watching folders" Command="{Binding StopWatchingCommand, Mode=OneWay}" />
                        <Separator />
                        <MenuItem Header="Colour label">
                            <MenuItem Header="None" Command="{Binding SetColorCommand, Mode=OneWay}" CommandParameter="" />
                            <MenuItem Header="Red" Command="{Binding SetColorCommand, Mode=OneWay}" CommandParameter="red" />
                            <MenuItem Header="Orange" Command="{Binding SetColorCommand, Mode=OneWay}" CommandParameter="orange" />
                            <MenuItem Header="Yellow" Command="{Binding SetColorCommand, Mode=OneWay}" CommandParameter="yellow" />
                            <MenuItem Header="Green" Command="{Binding SetColorCommand, Mode=OneWay}" CommandParameter="green" />
                            <MenuItem Header="Blue" Command="{Binding SetColorCommand, Mode=OneWay}" CommandParameter="blue" />
                            <MenuItem Header="Purple" Command="{Binding SetColorCommand, Mode=OneWay}" CommandParameter="purple" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Remove from project" Command="{Binding RemoveCommand, Mode=OneWay}" />
                    </ContextMenu>
                </ListView.ContextMenu>

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="16">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:MediaItemViewModel}">
                                    <Border Width="5"
                                            Height="16"
                                            CornerRadius="2"
                                            Background="{Binding Color, Mode=OneWay, Converter={StaticResource ColorLabel}}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Name" Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:MediaItemViewModel}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton Margin="0,0,4,0"
                                                          VerticalAlignment="Center"
                                                          Style="{DynamicResource ToggleButton.Disclosure}"
                                                          IsChecked="{Binding IsStreamListOpen, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding Name, Mode=OneWay}" VerticalAlignment="Center" />
                                            <TextBlock Text="  offline"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource Text.Caption}"
                                                       Foreground="{DynamicResource Brush.Error}"
                                                       ToolTip="The file is not where the project says: Find missing media relinks it"
                                                       Visibility="{Binding IsOffline, Mode=OneWay, Converter={StaticResource BoolToVisible}}" />
                                            <TextBlock Text="  conformed"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource Text.Caption}"
                                                       Foreground="{DynamicResource Brush.Warning}"
                                                       ToolTip="{Binding ConformSummary, Mode=OneWay}"
                                                       Visibility="{Binding IsConformed, Mode=OneWay, Converter={StaticResource BoolToVisible}}" />
                                            <TextBlock Text="  subclip"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource Text.Caption}"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                                       ToolTip="{Binding SubclipSummary, Mode=OneWay}"
                                                       Visibility="{Binding IsSubclip, Mode=OneWay, Converter={StaticResource BoolToVisible}}" />
                                        </StackPanel>
                                        <ItemsControl Margin="18,2,0,2"
                                                      ItemsSource="{Binding Streams, Mode=OneWay}"
                                                      Visibility="{Binding IsStreamListOpen, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Mode=OneWay}"
                                                               FontFamily="{DynamicResource Font.Mono}"
                                                               FontSize="{DynamicResource Text.Caption}"
                                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Duration" Width="90" DisplayMemberBinding="{Binding Duration, Mode=OneWay}" />
                        <GridViewColumn Header="Fps" Width="60" DisplayMemberBinding="{Binding FrameRate, Mode=OneWay}" />
                        <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding Size, Mode=OneWay}" />
                        <GridViewColumn Header="Codec" Width="70" DisplayMemberBinding="{Binding Codec, Mode=OneWay}" />
                        <GridViewColumn Header="Audio" Width="50" DisplayMemberBinding="{Binding AudioStreams, Mode=OneWay}" />
                        <GridViewColumn Header="Tags" Width="140" DisplayMemberBinding="{Binding Tags, Mode=OneWay}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Grid mode: tiles with a thumbnail, which scrubs through the file under the mouse. -->
            <ListBox Grid.Column="2"
                     AutomationProperties.Name="Media tiles"
                     Background="{DynamicResource Brush.Background.Base}"
                     BorderBrush="{DynamicResource Brush.Border}"
                     ItemsSource="{Binding Items, Mode=OneWay}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     PreviewMouseLeftButtonDown="OnListMouseDown"
                     MouseMove="OnListMouseMove"
                     MouseDoubleClick="OnItemDoubleClick"
                     Visibility="{Binding IsGridMode, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MediaItemViewModel}">
                        <StackPanel Width="140" Margin="4">
                            <!-- The poster, and the frame under the mouse while it moves across. -->
                            <Border Height="79"
                                    Background="{DynamicResource Brush.Background.Raised}"
                                    BorderBrush="{Binding Color, Mode=OneWay, Converter={StaticResource ColorLabel}}"
                                    BorderThickness="0,0,0,3"
                                    MouseMove="OnTileMouseMove"
                                    MouseLeave="OnTileMouseLeave">
                                <Grid>
                                    <TextBlock Text="{Binding Kind, Mode=OneWay}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text.Disabled}" />
                                    <Image Source="{Binding Thumbnail, Mode=OneWay}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Summary, Mode=OneWay}"
                                       FontSize="{DynamicResource Text.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- An empty bin says how to fill it. -->
            <TextBlock Grid.Column="2"
                       Margin="12,36,12,0"
                       VerticalAlignment="Top"
                       TextWrapping="Wrap"
                       IsHitTestVisible="False"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Text="No media yet. Drop recordings, music and images here, or import them with Ctrl+I; then drag them onto the timeline."
                       Visibility="{Binding IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisible}}" />
        </Grid>

        <StatusBar Grid.Row="3"
                   Background="{DynamicResource Brush.Background.Raised}"
                   Foreground="{DynamicResource Brush.Text.Secondary}">
            <TextBlock Text="{Binding CountSummary, Mode=OneWay}" />
            <Separator />
            <TextBlock Text="{Binding Status, Mode=OneWay}" />
        </StatusBar>
    </Grid>
</UserControl>
