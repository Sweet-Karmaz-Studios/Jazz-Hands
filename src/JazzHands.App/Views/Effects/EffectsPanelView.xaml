<UserControl x:Class="JazzHands.App.Views.Effects.EffectsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JazzHands.App.ViewModels.Effects"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:EffectsPanelViewModel}"
             d:DesignWidth="320"
             d:DesignHeight="500"
             Background="{DynamicResource Brush.Background.Panel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <Style x:Key="Button.Small" TargetType="ButtonBase" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Text.Caption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search. -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE721;"
                       FontFamily="{DynamicResource Font.Icon}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
            <TextBox Grid.Column="1"
                     Style="{StaticResource TextBox.Field}"
                     Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search effects by name, folder or id"
                     AutomationProperties.Name="Search effects" />
            <TextBlock Grid.Column="1"
                       Margin="7,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Text="Search effects"
                       Foreground="{DynamicResource Brush.Text.Disabled}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Search, Mode=OneWay}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Grid.Column="2"
                    Style="{StaticResource Button.Small}"
                    Content="&#xE711;"
                    Command="{Binding ClearSearchCommand, Mode=OneWay}"
                    ToolTip="Clear the search"
                    AutomationProperties.Name="Clear search" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Categories, Mode=OneWay}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EffectCategoryViewModel}">
                            <StackPanel Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource ToggleButton.Disclosure}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                  AutomationProperties.Name="Show or hide the folder" />
                                    <TextBlock Margin="6,0,0,0" Style="{StaticResource Heading}" Text="{Binding Title, Mode=OneWay}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Items, Mode=OneWay}"
                                              Focusable="False"
                                              Visibility="{Binding IsExpanded, Mode=OneWay, Converter={StaticResource Visible}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:EffectTypeItemViewModel}">
                                            <Border Margin="12,1,0,1"
                                                    Padding="4,0"
                                                    CornerRadius="3"
                                                    Background="Transparent"
                                                    ToolTip="{Binding Description, Mode=OneWay}"
                                                    MouseMove="OnEffectMouseMove"
                                                    MouseLeftButtonDown="OnEffectMouseDown">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- The effect on a sample scene; sound has none, and a picture arrives a moment after the panel. -->
                                                    <Border Width="64"
                                                            Height="36"
                                                            Margin="0,2,8,2"
                                                            CornerRadius="2"
                                                            ClipToBounds="True"
                                                            Background="{DynamicResource Brush.Background.Base}"
                                                            Visibility="{Binding HasPicture, Mode=OneWay, Converter={StaticResource Visible}}">
                                                        <Image Source="{Binding Preview, Mode=OneWay}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Name, Mode=OneWay}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                                    <ToggleButton Grid.Column="2"
                                                                  Style="{StaticResource Button.Small}"
                                                                  Content="&#xE734;"
                                                                  IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                                                  ToolTip="Favorite"
                                                                  AutomationProperties.Name="Favorite" />
                                                    <Button Grid.Column="3"
                                                            Content="&#xE710;"
                                                            Command="{Binding ApplyCommand, Mode=OneWay}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Small}">
                                                                <Setter Property="ToolTip" Value="Add to the selected clips" />
                                                                <Setter Property="AutomationProperties.Name" Value="Add to the selected clips" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsGenerator, Mode=OneWay}" Value="True">
                                                                        <Setter Property="ToolTip" Value="Add a clip at the playhead" />
                                                                        <Setter Property="AutomationProperties.Name" Value="Add a clip at the playhead" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Title presets: + adds one at the playhead, a drag puts one on a track. -->
                <Border Margin="0,8,0,4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                    <TextBlock Style="{StaticResource Heading}" Text="Title presets" />
                </Border>
                <TextBlock Text="A look and a place for a new title. Press + for one at the playhead, or drag one onto a video track."
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource Text.Caption}"
                           Foreground="{DynamicResource Brush.Text.Disabled}" />
                <ItemsControl ItemsSource="{Binding TitlePresets, Mode=OneWay}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TitlePresetItemViewModel}">
                            <Grid Margin="0,2" Background="Transparent" MouseMove="OnTitlePresetMouseMove" MouseLeftButtonDown="OnEffectMouseDown" ToolTip="{Binding Description, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Primary}" />
                                    <TextBlock Text="{Binding Description, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="{DynamicResource Text.Caption}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Button.Small}" Content="&#xE710;" Command="{Binding AddCommand, Mode=OneWay}" ToolTip="Add a title like this at the playhead" AutomationProperties.Name="Add title" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Presets saved in the project. -->
                <Border Margin="0,8,0,4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                    <TextBlock Style="{StaticResource Heading}" Text="Presets" />
                </Border>
                <TextBlock Text="Effect chains saved with this project, and the looks the editor comes with. Drag one onto a clip, or select clips and press +."
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource Text.Caption}"
                           Foreground="{DynamicResource Brush.Text.Disabled}" />
                <ItemsControl ItemsSource="{Binding Presets, Mode=OneWay}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EffectPresetItemViewModel}">
                            <Grid Margin="0,2" Background="Transparent" MouseMove="OnPresetMouseMove" MouseLeftButtonDown="OnEffectMouseDown">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Primary}" />
                                    <TextBlock Text="{Binding Summary, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="{DynamicResource Text.Caption}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Button.Small}" Content="&#xE710;" Command="{Binding ApplyCommand, Mode=OneWay}" ToolTip="Apply to the selected clips" AutomationProperties.Name="Apply preset" />
                                <Button Grid.Column="2" Style="{StaticResource Button.Small}" Content="&#xE74D;" Command="{Binding RemoveCommand, Mode=OneWay}" Visibility="{Binding CanRemove, Mode=OneWay, Converter={StaticResource Visible}}" ToolTip="Delete the preset" AutomationProperties.Name="Delete preset" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Save a preset, and anything that went wrong. -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource TextBox.Field}"
                         Text="{Binding PresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="A name for the selected clip's effects as a preset"
                         AutomationProperties.Name="Preset name" />
                <Button Grid.Column="1"
                        Margin="6,0,0,0"
                        Style="{StaticResource Button.Text}"
                        Content="Save as preset"
                        Command="{Binding SavePresetCommand, Mode=OneWay}"
                        AutomationProperties.Name="Save the selected clip's effects as a preset" />
            </Grid>
            <TextBlock Margin="0,4,0,0"
                       Text="{Binding Status, Mode=OneWay}"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource Text.Caption}"
                       Foreground="{DynamicResource Brush.Warning}" />
        </StackPanel>
    </Grid>
</UserControl>
