<Window x:Class="JazzHands.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:layout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        xmlns:controls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        xmlns:media="clr-namespace:JazzHands.App.Views.Media"
        xmlns:mediavm="clr-namespace:JazzHands.App.ViewModels.Media"
        xmlns:audio="clr-namespace:JazzHands.App.Views.Audio"
        xmlns:audiovm="clr-namespace:JazzHands.App.ViewModels.Audio"
        xmlns:playback="clr-namespace:JazzHands.App.Views.Playback"
        xmlns:playbackvm="clr-namespace:JazzHands.App.ViewModels.Playback"
        xmlns:timeline="clr-namespace:JazzHands.App.Views.Timeline"
        xmlns:timelinevm="clr-namespace:JazzHands.App.ViewModels.Timeline"
        xmlns:shell="clr-namespace:JazzHands.App.Shell"
        xmlns:export="clr-namespace:JazzHands.App.Views.Export"
        xmlns:exportvm="clr-namespace:JazzHands.App.ViewModels.Export"
        xmlns:inspector="clr-namespace:JazzHands.App.Views.Inspector"
        xmlns:inspectorvm="clr-namespace:JazzHands.App.ViewModels.Inspector"
        xmlns:effects="clr-namespace:JazzHands.App.Views.Effects"
        xmlns:effectsvm="clr-namespace:JazzHands.App.ViewModels.Effects"
        xmlns:vm="clr-namespace:JazzHands.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding Title, Mode=OneWay}"
        Height="720"
        Width="1280"
        Background="{DynamicResource Brush.Background.Base}"
        Foreground="{DynamicResource Brush.Text.Primary}">

    <Window.Resources>
        <!-- Which view draws which panel. Implicit, keyed by viewmodel type, so adding a panel in
             Phase 27 is a template here and a registration in AppServices. -->
        <DataTemplate DataType="{x:Type mediavm:MediaPanelViewModel}">
            <media:MediaPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type audiovm:MetersPanelViewModel}">
            <audio:MetersPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type playbackvm:PreviewPanelViewModel}">
            <playback:PreviewPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type timelinevm:TimelineViewModel}">
            <timeline:TimelineView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type inspectorvm:InspectorPanelViewModel}">
            <inspector:InspectorPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type effectsvm:EffectsPanelViewModel}">
            <effects:EffectsPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type exportvm:ExportQueuePanelViewModel}">
            <export:ExportQueuePanelView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0"
              Background="{DynamicResource Brush.Background.Raised}"
              Foreground="{DynamicResource Brush.Text.Primary}">
            <MenuItem Header="_File">
                <MenuItem Header="_Import media..." Command="{Binding Media.ImportCommand, Mode=OneWay}" />
                <MenuItem Header="Quick _Trim a recording..." Command="{Binding QuickTrimFileCommand, Mode=OneWay}" />
                <Separator />
                <MenuItem Header="_Export..." Command="{Binding ExportCommand, Mode=OneWay}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand, Mode=OneWay}" />
            </MenuItem>
            <MenuItem Header="_Playback">
                <MenuItem Header="_Play or pause" InputGestureText="Space" Command="{Binding Preview.TogglePlayCommand, Mode=OneWay}" />
                <MenuItem Header="_Stop" Command="{Binding Preview.StopCommand, Mode=OneWay}" />
                <MenuItem Header="Back one _frame" InputGestureText="Left" Command="{Binding Preview.StepBackCommand, Mode=OneWay}" />
                <MenuItem Header="Forward one f_rame" InputGestureText="Right" Command="{Binding Preview.StepForwardCommand, Mode=OneWay}" />
                <MenuItem Header="Go to st_art" InputGestureText="Home" Command="{Binding Preview.GoToStartCommand, Mode=OneWay}" />
                <MenuItem Header="Go to _end" InputGestureText="End" Command="{Binding Preview.GoToEndCommand, Mode=OneWay}" />
                <Separator />
                <MenuItem Header="Mark _in" InputGestureText="I" Command="{Binding Preview.SetInCommand, Mode=OneWay}" />
                <MenuItem Header="Mark _out" InputGestureText="O" Command="{Binding Preview.SetOutCommand, Mode=OneWay}" />
                <MenuItem Header="_Clear in and out" InputGestureText="Ctrl+Shift+X" Command="{Binding Preview.ClearInOutCommand, Mode=OneWay}" />
                <MenuItem Header="_Loop" InputGestureText="Ctrl+L" IsCheckable="True" IsChecked="{Binding Preview.Loop, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="F_ull screen" InputGestureText="F11" Command="{Binding Preview.ToggleFullScreenCommand, Mode=OneWay}" />
            </MenuItem>
        </Menu>

        <!--
            Phase 27 turns this into the full shell: every panel, the workspaces, and a layout
            service that maps a content id back to a viewmodel. The docking manager is here now
            with the one panel that exists, so the panel is written against the shape it keeps.
        -->
        <dock:DockingManager Grid.Row="1"
                             x:Name="Dock"
                             Background="{DynamicResource Brush.Background.Base}"
                             AnchorablesSource="{Binding Panels, Mode=OneWay}"
                             DocumentsSource="{Binding Timelines.Documents, Mode=OneWay}"
                             ActiveContent="{Binding Timelines.Active, Mode=TwoWay}">
            <dock:DockingManager.LayoutUpdateStrategy>
                <shell:PanelPlacement />
            </dock:DockingManager.LayoutUpdateStrategy>
            <dock:DockingManager.LayoutItemContainerStyle>
                <!-- On the common base, so panels and timeline documents both take their title and id
                     from their viewmodel. -->
                <Style TargetType="{x:Type controls:LayoutItem}">
                    <Setter Property="Title" Value="{Binding Model.Title, Mode=OneWay}" />
                    <Setter Property="ContentId" Value="{Binding Model.ContentId, Mode=OneWay}" />
                    <Setter Property="CanClose" Value="{Binding Model.CanClose, Mode=OneWay}" />
                </Style>
            </dock:DockingManager.LayoutItemContainerStyle>

            <layout:LayoutRoot>
                <layout:LayoutPanel Orientation="Horizontal">
                    <layout:LayoutAnchorablePane Name="ToolsPane" DockWidth="380" />
                    <layout:LayoutPanel Orientation="Vertical">
                        <layout:LayoutAnchorablePane Name="ProgramPane" DockHeight="*" />
                        <!-- One timeline tab per sequence. A pixel height, not a star: a star-sized
                             document pane takes the whole column from the preview. -->
                        <layout:LayoutDocumentPane DockHeight="300" />
                    </layout:LayoutPanel>
                    <!-- The inspector, beside the preview and the timeline, where the selected clip is changed. -->
                    <layout:LayoutAnchorablePane Name="InspectorPane" DockWidth="380" />
                </layout:LayoutPanel>
            </layout:LayoutRoot>
        </dock:DockingManager>
    </Grid>
</Window>
