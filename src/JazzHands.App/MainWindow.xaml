<Window x:Class="JazzHands.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:layout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        xmlns:controls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        xmlns:media="clr-namespace:JazzHands.App.Views.Media"
        xmlns:mediavm="clr-namespace:JazzHands.App.ViewModels.Media"
        xmlns:audio="clr-namespace:JazzHands.App.Views.Audio"
        xmlns:audiovm="clr-namespace:JazzHands.App.ViewModels.Audio"
        xmlns:subtitles="clr-namespace:JazzHands.App.Views.Subtitles"
        xmlns:subtitlesvm="clr-namespace:JazzHands.App.ViewModels.Subtitles"
        xmlns:playback="clr-namespace:JazzHands.App.Views.Playback"
        xmlns:playbackvm="clr-namespace:JazzHands.App.ViewModels.Playback"
        xmlns:timeline="clr-namespace:JazzHands.App.Views.Timeline"
        xmlns:timelinevm="clr-namespace:JazzHands.App.ViewModels.Timeline"
        xmlns:shell="clr-namespace:JazzHands.App.Shell"
        xmlns:jazzcontrols="clr-namespace:JazzHands.App.Controls"
        xmlns:export="clr-namespace:JazzHands.App.Views.Export"
        xmlns:exportvm="clr-namespace:JazzHands.App.ViewModels.Export"
        xmlns:remote="clr-namespace:JazzHands.App.Views.Remote"
        xmlns:remotevm="clr-namespace:JazzHands.App.ViewModels.Remote"
        xmlns:shellviews="clr-namespace:JazzHands.App.Views.Shell"
        xmlns:historyvm="clr-namespace:JazzHands.App.ViewModels.History"
        xmlns:logvm="clr-namespace:JazzHands.App.ViewModels.Logging"
        xmlns:markersvm="clr-namespace:JazzHands.App.ViewModels.Markers"
        xmlns:curvesvm="clr-namespace:JazzHands.App.ViewModels.Curves"
        xmlns:curvesviews="clr-namespace:JazzHands.App.Views.Curves"
        xmlns:inspector="clr-namespace:JazzHands.App.Views.Inspector"
        xmlns:inspectorvm="clr-namespace:JazzHands.App.ViewModels.Inspector"
        xmlns:effects="clr-namespace:JazzHands.App.Views.Effects"
        xmlns:effectsvm="clr-namespace:JazzHands.App.ViewModels.Effects"
        xmlns:grading="clr-namespace:JazzHands.App.Views.Grading"
        xmlns:gradingvm="clr-namespace:JazzHands.App.ViewModels.Grading"
        xmlns:vm="clr-namespace:JazzHands.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding Title, Mode=OneWay}"
        Icon="Assets/jazz.ico"
        Height="720"
        Width="1280"
        Background="{DynamicResource Brush.Background.Base}"
        Foreground="{DynamicResource Brush.Text.Primary}">

    <Window.TaskbarItemInfo>
        <!-- The taskbar button fills as exports and proxies run, turns red when one fails, carries
             a badge for exporting, failed or a client attached, and has play and edit buttons on
             its thumbnail. -->
        <TaskbarItemInfo ProgressState="{Binding Desktop.ProgressState, Mode=OneWay, FallbackValue=None}"
                         ProgressValue="{Binding Desktop.ProgressValue, Mode=OneWay, FallbackValue=0}"
                         Overlay="{Binding Desktop.Badge, Mode=OneWay, Converter={x:Static shellviews:BadgeImageConverter.Instance}}"
                         Description="{Binding Desktop.ToolTip, Mode=OneWay, FallbackValue='Jazz Hands'}">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo ImageSource="{StaticResource Icon.Thumb.Previous}" Description="Previous edit" Command="{Binding ThumbPreviousEditCommand, Mode=OneTime}" />
                <ThumbButtonInfo ImageSource="{StaticResource Icon.Thumb.PlayPause}" Description="Play or pause" Command="{Binding ThumbPlayPauseCommand, Mode=OneTime}" />
                <ThumbButtonInfo ImageSource="{StaticResource Icon.Thumb.Next}" Description="Next edit" Command="{Binding ThumbNextEditCommand, Mode=OneTime}" />
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <!-- Which view draws which panel. Implicit, keyed by viewmodel type, so adding a panel in
             Phase 27 is a template here and a registration in AppServices. -->
        <DataTemplate DataType="{x:Type mediavm:MediaPanelViewModel}">
            <media:MediaPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type subtitlesvm:SubtitlesPanelViewModel}">
            <subtitles:SubtitlesPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type audiovm:MixerPanelViewModel}">
            <audio:MixerPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type audiovm:MetersPanelViewModel}">
            <audio:MetersPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type playbackvm:PreviewPanelViewModel}">
            <playback:PreviewPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type playbackvm:SourcePanelViewModel}">
            <playback:SourcePanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type timelinevm:TimelineViewModel}">
            <timeline:TimelineView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type inspectorvm:InspectorPanelViewModel}">
            <inspector:InspectorPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type effectsvm:EffectsPanelViewModel}">
            <effects:EffectsPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type gradingvm:ScopesPanelViewModel}">
            <grading:ScopesPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type gradingvm:ColorPanelViewModel}">
            <grading:ColorPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type exportvm:ExportQueuePanelViewModel}">
            <export:ExportQueuePanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type remotevm:CommandConsoleViewModel}">
            <remote:CommandConsoleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type historyvm:HistoryPanelViewModel}">
            <shellviews:HistoryPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type logvm:LogPanelViewModel}">
            <shellviews:LogPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type markersvm:MarkersPanelViewModel}">
            <shellviews:MarkersPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type curvesvm:CurveEditorPanelViewModel}">
            <curvesviews:CurveEditorPanelView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The menu is the main viewmodel's, built from the keymap so each item shows the keys
             bound to it now. Ticks are read as a menu opens (MenuOpened in code-behind). A queued
             menu, so a screen reader's Invoke of an item that opens a file picker returns. -->
        <jazzcontrols:QueuedMenu x:Name="MainMenu"
              Grid.Row="0"
              Style="{StaticResource {x:Type Menu}}"
              ItemsSource="{Binding Menu, Mode=OneWay}"
              MenuItem.SubmenuOpened="OnSubmenuOpened"
              ItemContainerStyle="{StaticResource MenuItem.FromViewModel}"
              Background="{DynamicResource Brush.Background.Raised}"
              Foreground="{DynamicResource Brush.Text.Primary}">
        </jazzcontrols:QueuedMenu>

        <!--
            Phase 27 turns this into the full shell: every panel, the workspaces, and a layout
            service that maps a content id back to a viewmodel. The docking manager is here now
            with the one panel that exists, so the panel is written against the shape it keeps.
        -->
        <dock:DockingManager Grid.Row="1"
                             x:Name="Dock"
                             Background="{DynamicResource Brush.Background.Base}"
                             AnchorablesSource="{Binding Panels, Mode=OneWay}"
                             DocumentsSource="{Binding Timelines.Documents, Mode=OneWay}"
                             ActiveContent="{Binding Timelines.Active, Mode=TwoWay}">
            <dock:DockingManager.Resources>
                <!-- AvalonDock's own tabs are the light Windows ones, and the theme's text on them was
                     white on white: panel tabs in a shared pane and the timeline's document tab. Its
                     pane controls set their tab style themselves, so the panes below are given this one. -->
                <Style x:Key="Dock.Tab" TargetType="{x:Type TabItem}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Border x:Name="Chrome"
                                        Background="{DynamicResource Brush.Background.Panel}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="0,0,1,0"
                                        Padding="8,3">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Background.Selected}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </dock:DockingManager.Resources>
            <dock:DockingManager.LayoutUpdateStrategy>
                <shell:PanelPlacement />
            </dock:DockingManager.LayoutUpdateStrategy>
            <dock:DockingManager.LayoutItemContainerStyle>
                <!-- On the common base, so panels and timeline documents both take their title and id
                     from their viewmodel. -->
                <Style TargetType="{x:Type controls:LayoutItem}">
                    <Setter Property="Title" Value="{Binding Model.Title, Mode=OneWay}" />
                    <Setter Property="ContentId" Value="{Binding Model.ContentId, Mode=OneWay}" />
                    <Setter Property="CanClose" Value="{Binding Model.CanClose, Mode=OneWay}" />
                </Style>
            </dock:DockingManager.LayoutItemContainerStyle>

            <layout:LayoutRoot>
                <layout:LayoutPanel Orientation="Horizontal">
                    <layout:LayoutAnchorablePane Name="ToolsPane" DockWidth="380" />
                    <layout:LayoutPanel Orientation="Vertical">
                        <!-- The preview has the pixel height and the timeline takes the rest: AvalonDock
                             always makes the document pane the star in its column and pins the others
                             to their height when it first lays them out, which on a fresh start is the
                             preview's 25 pixel minimum (the preview was a star and vanished). -->
                        <layout:LayoutAnchorablePane Name="ProgramPane" DockHeight="560" DockMinHeight="200" />
                        <!-- One timeline tab per sequence. -->
                        <layout:LayoutDocumentPane />
                    </layout:LayoutPanel>
                    <!-- On the right: the inspector, where the selected clip is changed, and under it the
                         panels that watch (meters, the export queue, the console, the log), so no pane
                         holds so many tabs that their names are cut short. -->
                    <layout:LayoutPanel Orientation="Vertical" DockWidth="380">
                        <layout:LayoutAnchorablePane Name="InspectorPane" DockHeight="2*" />
                        <layout:LayoutAnchorablePane Name="UtilityPane" DockHeight="*" DockMinHeight="120" />
                    </layout:LayoutPanel>
                </layout:LayoutPanel>
            </layout:LayoutRoot>
        </dock:DockingManager>

        <!-- Notifications: up to three toasts in the bottom right, each for five seconds. -->
        <ItemsControl Grid.Row="1"
                      Margin="0,0,16,16"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      MaxWidth="360"
                      ItemsSource="{Binding StatusBar.Notifications.Toasts, Mode=OneWay}"
                      AutomationProperties.Name="Notifications">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,8,0,0"
                            Padding="12,8"
                            CornerRadius="4"
                            Background="{DynamicResource Brush.Background.Raised}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level, Mode=OneWay}" Value="Warning">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level, Mode=OneWay}" Value="Error">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Primary}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- While the control server listens where other machines can reach it, say so, always. -->
        <Border Grid.Row="2"
                Padding="8,4"
                Background="{DynamicResource Brush.Background.Raised}"
                BorderBrush="{DynamicResource Brush.Warning}"
                BorderThickness="0,1,0,0"
                AutomationProperties.Name="Remote control warning">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Console.NetworkWarning, Mode=OneWay, FallbackValue=''}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Console.NetworkWarning, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Warning}" />
        </Border>

        <!-- The status bar: tool and snapping; playhead and format; exports, cache, GPU, remote; the bell. -->
        <Border Grid.Row="3"
                Padding="8,2"
                Background="{DynamicResource Brush.Background.Raised}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                TextElement.FontSize="{DynamicResource Text.Caption}"
                TextElement.Foreground="{DynamicResource Brush.Text.Secondary}"
                AutomationProperties.Name="Status bar">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusBar.Tool, Mode=OneWay}" VerticalAlignment="Center" />
                <ToggleButton x:Name="Bell"
                              DockPanel.Dock="Right"
                              Style="{StaticResource Button.Icon}"
                              Margin="8,0,0,0"
                              Content="&#xEA8F;"
                              Checked="OnBellOpened"
                              ToolTip="{Binding StatusBar.Notifications.Unread, Mode=OneWay, StringFormat='Notifications ({0} new)'}"
                              AutomationProperties.Name="Notifications" />
                <Popup DockPanel.Dock="Right"
                       PlacementTarget="{Binding ElementName=Bell}"
                       Placement="Top"
                       StaysOpen="False"
                       IsOpen="{Binding IsChecked, ElementName=Bell, Mode=TwoWay}">
                    <Border Width="380" MaxHeight="360" Padding="8" Background="{DynamicResource Brush.Background.Panel}" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1">
                        <ListBox ItemsSource="{Binding StatusBar.Notifications.History, Mode=OneWay}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Notification history">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Primary}">
                                        <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Disabled}" />
                                        <Run Text="{Binding Text, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
                <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" Text="{Binding StatusBar.Remote, Mode=OneWay}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
                <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" Text="{Binding StatusBar.Gpu, Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" Text="{Binding StatusBar.Cache, Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" Text="{Binding StatusBar.ExportsText, Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Margin="24,0,0,0" Text="{Binding StatusBar.Timecode, Mode=OneWay}" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock DockPanel.Dock="Left" Margin="12,0,0,0" Text="{Binding StatusBar.Format, Mode=OneWay}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- The tour's outline round the part a card is about: over everything, never in the mouse's way. -->
        <Canvas x:Name="TourLayer" Grid.RowSpan="4" IsHitTestVisible="False" Panel.ZIndex="100">
            <Rectangle x:Name="TourOutline"
                       Stroke="{DynamicResource Brush.Error}"
                       StrokeThickness="3"
                       RadiusX="4"
                       RadiusY="4"
                       Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>
