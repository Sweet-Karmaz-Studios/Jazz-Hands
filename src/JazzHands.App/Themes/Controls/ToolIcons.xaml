<!--
    The timeline's tools as line drawings on a 16 unit grid, one stroke weight, drawn by
    Button.Tool in the button's colour. Segoe Fluent Icons has nothing for ripple, roll, slip or
    slide, so all eight are drawn here in one hand rather than mixing glyphs and drawings.
    Each draws what the tool does to a clip: the clip is a box, an edge is a bracket.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- V: the pointer. -->
    <Geometry x:Key="Tool.Select">M4.5,2 L4.5,13 L7.2,10.4 L9.2,14.5 L11,13.7 L9,9.6 L12.5,9.6 Z</Geometry>

    <!-- C: a clip cut through. -->
    <Geometry x:Key="Tool.Razor">M1.5,4.5 L6.5,4.5 M9.5,4.5 L14.5,4.5 M1.5,11.5 L6.5,11.5 M9.5,11.5 L14.5,11.5 M1.5,4.5 L1.5,11.5 M14.5,4.5 L14.5,11.5 M8,1.5 L8,14.5</Geometry>

    <!-- B: an edge, and everything after it following. -->
    <Geometry x:Key="Tool.Ripple">M5.5,3 L3,3 L3,13 L5.5,13 M7,8 L14,8 M11.5,5.5 L14,8 L11.5,10.5</Geometry>

    <!-- N: the cut between two clips, moving either way. -->
    <Geometry x:Key="Tool.Roll">M4.5,3 L6.5,3 L6.5,13 L4.5,13 M11.5,3 L9.5,3 L9.5,13 L11.5,13 M4,8 L1.5,8 M3,6.5 L1.5,8 L3,9.5 M12,8 L14.5,8 M13,6.5 L14.5,8 L13,9.5</Geometry>

    <!-- Y: the clip stays; what it shows moves inside it. -->
    <Geometry x:Key="Tool.Slip">M1.5,4.5 L14.5,4.5 L14.5,11.5 L1.5,11.5 Z M4.5,8 L11.5,8 M6,6.5 L4.5,8 L6,9.5 M10,6.5 L11.5,8 L10,9.5</Geometry>

    <!-- U: the clip moves between its neighbours. -->
    <Geometry x:Key="Tool.Slide">M5.5,6.5 L10.5,6.5 L10.5,13 L5.5,13 Z M1.5,6.5 L1.5,13 M14.5,6.5 L14.5,13 M4.5,3 L11.5,3 M6,1.5 L4.5,3 L6,4.5 M10,1.5 L11.5,3 L10,4.5</Geometry>

    <!-- R: an end dragged out, the clip faster or slower. -->
    <Geometry x:Key="Tool.RateStretch">M10.5,4.5 L1.5,4.5 L1.5,11.5 L10.5,11.5 M10.5,8 L14.5,8 M12.5,6 L14.5,8 L12.5,10 M4,6 L6,8 L4,10 M7,6 L9,8 L7,10</Geometry>

    <!-- H: the view dragged any way. -->
    <Geometry x:Key="Tool.Hand">M8,1.5 L8,14.5 M1.5,8 L14.5,8 M6.3,3.2 L8,1.5 L9.7,3.2 M6.3,12.8 L8,14.5 L9.7,12.8 M3.2,6.3 L1.5,8 L3.2,9.7 M12.8,6.3 L14.5,8 L12.8,9.7</Geometry>

    <!--
        A tool button: its Content is one of the geometries above, drawn in its Foreground. Tag
        true is the tool in hand, drawn in the accent.
    -->
    <Style x:Key="Button.Tool" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3">
                        <Path Width="16"
                              Height="16"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.25"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              SnapsToDevicePixels="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Background.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Background.Selected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, Mode=OneWay}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
