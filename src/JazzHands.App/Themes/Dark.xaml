<!--
    The one theme. Every colour in the application is a brush resource named here and referenced
    with DynamicResource, so a view never spells a colour out and the whole surface can be
    retuned in one file. Phase 27 adds the per-control styles that sit on top of these tokens;
    Phase 35 is the pass that decides whether the values are right.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Surfaces, from the window out to the things that float above it. -->
    <SolidColorBrush x:Key="Brush.Background.Base" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="Brush.Background.Panel" Color="#FF222222" />
    <SolidColorBrush x:Key="Brush.Background.Raised" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="Brush.Background.Input" Color="#FF161616" />
    <SolidColorBrush x:Key="Brush.Background.Hover" Color="#FF303030" />
    <SolidColorBrush x:Key="Brush.Background.Selected" Color="#FF37485C" />

    <SolidColorBrush x:Key="Brush.Border" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#FF4C4C4C" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#FF9A9A9A" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#FF6A6A6A" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#FF4C9AFF" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFE0A33C" />
    <SolidColorBrush x:Key="Brush.Error" Color="#FFE05C5C" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF5CC85C" />

    <!-- The preview: the picture sits on true black, and its guides are translucent so they read
         over any footage without hiding it. -->
    <SolidColorBrush x:Key="Brush.Preview.Background" Color="#FF000000" />
    <SolidColorBrush x:Key="Brush.Preview.Guide" Color="#B0FFFFFF" />
    <SolidColorBrush x:Key="Brush.Preview.TitleSafe" Color="#B0E0A33C" />

    <!--
        The bin's colour labels. The names are what media.set takes on the command line, so the
        palette here and CommandValues.ParseColor have to agree.
    -->
    <SolidColorBrush x:Key="Brush.Label.None" Color="#00000000" />
    <SolidColorBrush x:Key="Brush.Label.Red" Color="#FFD05353" />
    <SolidColorBrush x:Key="Brush.Label.Orange" Color="#FFD08A3E" />
    <SolidColorBrush x:Key="Brush.Label.Yellow" Color="#FFC9C14E" />
    <SolidColorBrush x:Key="Brush.Label.Green" Color="#FF5FA95F" />
    <SolidColorBrush x:Key="Brush.Label.Blue" Color="#FF4C8AD0" />
    <SolidColorBrush x:Key="Brush.Label.Purple" Color="#FF9A6FC4" />
    <SolidColorBrush x:Key="Brush.Label.Grey" Color="#FF808080" />

    <!-- Typography. Three sizes and two families is the whole vocabulary. -->
    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="Text.Body">12</sys:Double>
    <sys:Double x:Key="Text.Caption">11</sys:Double>
    <sys:Double x:Key="Text.Heading">14</sys:Double>

    <!-- Spacing steps. Anything that is not one of these is a mistake somebody should notice. -->
    <Thickness x:Key="Space.Tight">4</Thickness>
    <Thickness x:Key="Space.Normal">8</Thickness>
    <Thickness x:Key="Space.Loose">12</Thickness>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Body}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Input}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="4,3" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Body}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Body}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

</ResourceDictionary>
