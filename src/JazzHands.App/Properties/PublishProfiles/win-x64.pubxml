<?xml version="1.0" encoding="utf-8"?>
<!--
  The editor compiled ahead of time with ReadyToRun, so starting does not wait on the JIT for the
  code every launch runs (Phase 32; Docs/PERF.md has the startup steps before and after).
  Framework dependent for now: Phase 34's installer decides whether the .NET desktop runtime
  comes with it.

    dotnet publish src/JazzHands.App -c Release -p:PublishProfile=win-x64

  The result is in artifacts/app/win-x64. FFmpeg is found as for jazz.exe: an ffmpeg folder
  beside the executable first.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\app\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
