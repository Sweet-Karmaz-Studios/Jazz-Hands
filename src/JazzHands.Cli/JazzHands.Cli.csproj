<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>jazz</AssemblyName>
    <Description>The jazz command line tool.</Description>
    <!-- jazz-mcp is an exe referenced for its server; jazz publishes self-contained, it does not. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JazzHands.Control\JazzHands.Control.csproj" />
    <!-- jazz mcp runs the MCP server in process; jazz-mcp.exe runs the same one. -->
    <ProjectReference Include="..\JazzHands.Mcp\JazzHands.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
  </ItemGroup>

  <!-- A published jazz.exe carries the FFmpeg libraries in a folder beside it. -->
  <Target Name="CopyFfmpegToPublish" AfterTargets="Publish">
    <ItemGroup>
      <FfmpegLibrary Include="$(MSBuildThisFileDirectory)..\..\third_party\ffmpeg\bin\*.dll" />
    </ItemGroup>
    <Error Condition="'@(FfmpegLibrary)' == ''" Text="third_party/ffmpeg/bin has no DLLs. Run tools/get-ffmpeg.ps1 first." />
    <Copy SourceFiles="@(FfmpegLibrary)" DestinationFolder="$(PublishDir)ffmpeg" SkipUnchangedFiles="true" />
  </Target>

  <!-- The prose that jazz docs puts around the generated reference. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Docs\cli\*.md" LogicalName="doc:%(Filename)" />
    <EmbeddedResource Include="..\..\Docs\cli\notes\*.md" LogicalName="note:%(Filename)" />
  </ItemGroup>

</Project>
