<?xml version="1.0" encoding="utf-8"?>
<!--
  jazz.exe as one self-contained file, with the FFmpeg shared libraries in an ffmpeg folder beside
  it, where FfmpegLoader looks first. Nothing else to install: no .NET runtime, no PATH entry
  (Phase 34's installer adds one).

    dotnet publish src/JazzHands.Cli -c Release -p:PublishProfile=win-x64

  The result is in artifacts/jazz/win-x64. Trimming stays off: the command registry, the effect
  catalog and System.Text.Json all find types by reflection.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\jazz\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
