<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Direct3D 11 compositor, effect graph, HLSL effects, text, transitions and scopes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JazzHands.Core\JazzHands.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JazzHands.Render.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shaders are embedded and compiled at runtime, so editing one needs no build step and the
         compiled cache can key on the source hash. -->
    <EmbeddedResource Include="Shaders\*.hlsl" />
    <EmbeddedResource Include="Shaders\*.hlsli" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DXGI" />
    <PackageReference Include="Vortice.Direct2D1" />
    <PackageReference Include="Vortice.D3DCompiler" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

</Project>
