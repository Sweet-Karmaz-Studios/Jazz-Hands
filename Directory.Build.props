<Project>

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(SelfContained)' != 'true' and '$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Globalization stays on: WPF font handling needs real culture data (MS.Internal.FontCache
         asks for "en"), and titles, subtitles and timecode all run through it. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1848;CA1031</NoWarn>
  </PropertyGroup>

  <!-- Deterministic, source-linked builds. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Identity. -->
  <PropertyGroup>
    <Product>Jazz Hands</Product>
    <Company>Sweet Karmaz Studios</Company>
    <Authors>Sweet Karmaz Studios</Authors>
    <Copyright>Copyright (c) Sweet Karmaz Studios</Copyright>
    <VersionPrefix>0.1.0</VersionPrefix>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <!-- AssemblyName is deliberately not set here. It defaults to the project name already, and
         setting it in Directory.Build.props breaks WPF: the XAML markup compiler builds a
         generated <name>_<hash>_wpftmp project to resolve types the XAML refers to in this same
         assembly, that project imports this file, and the value it computes for itself stops
         MarkupCompilePass2 finding those types. It fails as "MC3050: cannot find the type" on
         perfectly ordinary XAML. A project that wants a different assembly name sets it in its
         own file, which still works. -->

    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!-- Repo-relative paths every project can rely on. -->
  <PropertyGroup>
    <JazzRepoRoot>$([MSBuild]::EnsureTrailingSlash('$(MSBuildThisFileDirectory)'))</JazzRepoRoot>
    <JazzFfmpegDir>$(JazzRepoRoot)third_party\ffmpeg\</JazzFfmpegDir>
    <JazzCorpusDir>$(JazzRepoRoot)tests\corpus\</JazzCorpusDir>
  </PropertyGroup>

  <!-- Test projects: xUnit v3 runs as an executable on Microsoft.Testing.Platform. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) or '$(MSBuildProjectName)' == 'JazzHands.UiTests'">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) or '$(MSBuildProjectName)' == 'JazzHands.UiTests'">
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
